  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_open_calls"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_open_ms_total"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_open_ms_avg"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_close_calls"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_close_explicit_calls"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_close_object_free_calls"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_close_reopen_calls"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_close_ms_total"] = 1
  phase_metric["wordpress_perf_summary_mysqli_process_implicit_profile_close_ms_avg"] = 1
  phase_metric["wordpress_perf_summary_mysqli_inprocess_connect_close_ms_avg"] = 1
  phase_metric["wordpress_perf_summary_mysqli_active_runtime_reconnect_ms_avg"] = 1
  phase_metric["wordpress_perf_summary_select1_ops_per_second"] = 1
  phase_metric["wordpress_perf_summary_insert_txn_ops_per_second"] = 1
  phase_metric["wordpress_perf_summary_point_select_ops_per_second"] = 1
  phase_metric["wordpress_perf_summary_insert_autocommit_ops_per_second"] = 1
  phase_metric["wordpress_perf_summary_insert_direct_autocommit_ops_per_second"] = 1
}

/^\|/ {
  fields = split($0, cells, "|")
  if (fields < 4) {
    next
  }

  row_label = trim(cells[2])
  metric = trim(cells[3])
  value = trim(cells[4])

  if (row_label == "label" || row_label == "---" || metric == "---" || row_label == rollup_label) {
    next
  }

  if (metric == "wordpress_total_seconds" && is_number(value)) {
    count_once("phase_all", row_label)
    add_sum("phase_all", metric, value)
    add_shard_phase(row_label, value)
    if (row_label !~ /^(artifact-download|artifact-extract|docker-image|phpunit)-/) {
      count_once("setup_phase", row_label)
      add_sum("setup_phase", metric, value)
    }
  }

  if (row_label == "build-php" && metric in build_metric) {
    count_once("build", row_label)
    add_sum("build", metric, value)
  }

  if (metric in phase_metric) {
    add_sum("phase_metric", metric, value)
  }

  if (row_label !~ /^phpunit-/ || !(metric in phpunit_metric)) {
    next
  }

  count_once("phpunit_all", row_label)
  add_sum("phpunit_all", metric, value)
  if (metric == "wordpress_phpunit_shell_real_seconds") {
    note_max("wordpress_phpunit_shell_real_seconds", value, row_label)
    add_shard_phpunit_shell(row_label, value)
  }
  if (metric == "wordpress_total_seconds") {
    note_max("wordpress_phpunit_total_seconds", value, row_label)
  }

  if (row_label == "phpunit-db-profile") {
    count_once("phpunit_diagnostic", row_label)
    add_sum("phpunit_diagnostic", metric, value)
    next
  }

  count_once("phpunit_test", row_label)
  add_sum("phpunit_test", metric, value)

  if (row_label == "phpunit-db") {
    count_once("phpunit_db", row_label)
    add_sum("phpunit_db", metric, value)
  } else if (row_label ~ /^phpunit-deferred-reconnect-/) {
    count_once("phpunit_isolated", row_label)
    add_sum("phpunit_isolated", metric, value)
  } else if (row_label ~ /^phpunit-non-isolated-/) {
    count_once("phpunit_non_isolated", row_label)
    add_sum("phpunit_non_isolated", metric, value)
  } else {
    count_once("phpunit_other_test", row_label)
    add_sum("phpunit_other_test", metric, value)
  }
}

END {
  shard_max_seconds = 0
  shard_max_label = ""
  for (shard in shard_seen) {
    if (shard_seconds[shard] > shard_max_seconds) {
      shard_max_seconds = shard_seconds[shard]
      shard_max_label = shard
    }
    if (shard_has_phase(shard, "phpunit_shell")) {
      shard_non_phpunit_shell_seconds = shard_seconds[shard] - shard_phpunit_shell_seconds[shard]
      if (shard_non_phpunit_shell_seconds < 0) {
        shard_non_phpunit_shell_seconds = 0
      }
      if (!shard_non_phpunit_shell_max_seen || shard_non_phpunit_shell_seconds > shard_non_phpunit_shell_max) {
        shard_non_phpunit_shell_max_seen = 1
        shard_non_phpunit_shell_max = shard_non_phpunit_shell_seconds
        shard_non_phpunit_shell_max_label = shard
      }
    }
  }

  emit_bucket("phpunit_test", "wordpress_phpunit_test")
  emit_bucket("phpunit_diagnostic", "wordpress_phpunit_diagnostic")
  emit_bucket("phpunit_all", "wordpress_phpunit_all")
  emit_bucket("phpunit_db", "wordpress_phpunit_db")
  emit_bucket("phpunit_isolated", "wordpress_phpunit_isolated")
  emit_bucket("phpunit_non_isolated", "wordpress_phpunit_non_isolated")
  emit_bucket("phpunit_other_test", "wordpress_phpunit_other_test")

  if (counts["build"] > 0) {
    row_int("wordpress_build_phase_count", counts["build"])
    emit_sum("build", "mylite_mariadb_embedded_seconds", "wordpress_build_mariadb_embedded_seconds")
    emit_sum("build", "mylite_php_configure_seconds", "wordpress_build_php_configure_seconds")
    emit_sum("build", "mylite_php_build_seconds", "wordpress_build_php_seconds")
    emit_sum("build", "mylite_php_wrapper_seconds", "wordpress_build_php_wrapper_seconds")
    emit_sum("build", "mylite_build_seconds", "wordpress_build_inner_seconds")
    emit_sum("build", "wordpress_container_seconds", "wordpress_build_container_seconds")
    emit_sum("build", "wordpress_total_seconds", "wordpress_build_total_seconds")
  }

  if (counts["phase_all"] > 0) {
    row_int("wordpress_timed_phase_count", counts["phase_all"])
    emit_sum("phase_all", "wordpress_total_seconds", "wordpress_timed_phase_total_seconds_sum")
  }
  if (counts["setup_phase"] > 0) {
    row_int("wordpress_setup_phase_count", counts["setup_phase"])
    emit_sum("setup_phase", "wordpress_total_seconds", "wordpress_setup_total_seconds_sum")
  }
  if (shard_count > 0) {
    row_int("wordpress_shard_phase_count", shard_count)
    row("wordpress_shard_critical_path_label", shard_max_label)
    row_num("wordpress_shard_critical_path_seconds_max", shard_max_seconds)
    row_num("wordpress_shard_critical_path_artifact_download_seconds", shard_phase_value(shard_max_label, "artifact_download"))
    row_num("wordpress_shard_critical_path_artifact_extract_seconds", shard_phase_value(shard_max_label, "artifact_extract"))
    row_num("wordpress_shard_critical_path_docker_image_seconds", shard_phase_value(shard_max_label, "docker_image"))
    row_num("wordpress_shard_critical_path_phpunit_total_seconds", shard_phase_value(shard_max_label, "phpunit_total"))
    if (shard_has_phase(shard_max_label, "phpunit_shell")) {
      row_num("wordpress_shard_critical_path_phpunit_shell_real_seconds", shard_phpunit_shell_seconds[shard_max_label])
      shard_critical_non_phpunit_shell_seconds = shard_max_seconds - shard_phpunit_shell_seconds[shard_max_label]
      if (shard_critical_non_phpunit_shell_seconds < 0) {
        shard_critical_non_phpunit_shell_seconds = 0
      }
      row_num("wordpress_shard_critical_path_non_phpunit_shell_seconds", shard_critical_non_phpunit_shell_seconds)
    }
    if (metric_seen("setup_phase", "wordpress_total_seconds")) {
      estimated_critical_path = metric_sum("setup_phase", "wordpress_total_seconds") + shard_max_seconds
      row_num("wordpress_estimated_workflow_critical_path_seconds", estimated_critical_path)
    }
  }
  if (shard_non_phpunit_shell_max_seen) {
    row("wordpress_shard_non_phpunit_shell_seconds_max_label", shard_non_phpunit_shell_max_label)
    row_num("wordpress_shard_non_phpunit_shell_seconds_max", shard_non_phpunit_shell_max)
  }
  if ("wordpress_phpunit_shell_real_seconds" in max_seen) {
    row("wordpress_phpunit_shell_real_seconds_max_label", max_labels["wordpress_phpunit_shell_real_seconds"])
    row_num("wordpress_phpunit_shell_real_seconds_max", max_values["wordpress_phpunit_shell_real_seconds"])
  }
  if ("wordpress_phpunit_total_seconds" in max_seen) {
    row("wordpress_phpunit_total_seconds_max_label", max_labels["wordpress_phpunit_total_seconds"])
    row_num("wordpress_phpunit_total_seconds_max", max_values["wordpress_phpunit_total_seconds"])
  }

  emit_sum("phase_metric", "wordpress_docker_build_seconds", "wordpress_docker_build_seconds")
  emit_sum("phase_metric", "wordpress_fetch_seconds", "wordpress_fetch_seconds")
  emit_sum("phase_metric", "wordpress_dependency_seconds", "wordpress_dependency_seconds")
  emit_sum("phase_metric", "wordpress_prepare_db_seconds", "wordpress_prepare_db_seconds")
  emit_sum("phase_metric", "wordpress_artifact_pack_seconds", "wordpress_artifact_pack_seconds")
  emit_sum("phase_metric", "wordpress_artifact_upload_seconds", "wordpress_artifact_upload_seconds")
  emit_sum("phase_metric", "wordpress_artifact_download_seconds", "wordpress_artifact_download_seconds")
  emit_sum("phase_metric", "wordpress_artifact_extract_seconds", "wordpress_artifact_extract_seconds")
  emit_int_sum("phase_metric", "wordpress_artifact_pack_runtime_tar_bytes", "wordpress_artifact_pack_runtime_tar_bytes")
  emit_int_sum("phase_metric", "wordpress_artifact_pack_db_baseline_tar_bytes", "wordpress_artifact_pack_db_baseline_tar_bytes")
  emit_int_sum("phase_metric", "wordpress_artifact_extract_runtime_tar_bytes", "wordpress_artifact_extract_runtime_tar_bytes_sum")
  emit_int_sum("phase_metric", "wordpress_artifact_extract_db_baseline_tar_bytes", "wordpress_artifact_extract_db_baseline_tar_bytes_sum")
  emit_sum("phase_metric", "wordpress_perf_summary_stock_php_process_start_ms_avg", "wordpress_perf_stock_php_process_start_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_process_start_ms_avg", "wordpress_perf_php_process_start_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_extension_process_overhead_ms_avg", "wordpress_perf_php_extension_process_overhead_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_connect_process_ms_avg", "wordpress_perf_php_connect_process_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_connect_process_explicit_close_ms_avg", "wordpress_perf_php_connect_process_explicit_close_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_connect_process_implicit_object_free_ms_avg", "wordpress_perf_php_connect_process_implicit_object_free_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_connect_process_delta_ms_avg", "wordpress_perf_php_connect_process_delta_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_connect_process_implicit_object_free_delta_ms_avg", "wordpress_perf_php_connect_process_implicit_object_free_delta_ms_avg")
  emit_sum("phase_metric", "wordpress_perf_summary_php_connect_process_implicit_minus_explicit_ms_avg", "wordpress_perf_php_connect_process_implicit_minus_explicit_ms_avg")
