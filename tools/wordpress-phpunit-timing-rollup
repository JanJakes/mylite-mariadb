#!/usr/bin/env bash
set -euo pipefail

input="${MYLITE_WORDPRESS_TIMING_SUMMARY_PATH:-}"
append=0
label=timing-rollup

usage() {
  cat <<'USAGE'
Usage: wordpress-phpunit-timing-rollup [--input PATH] [--append] [--label LABEL]

Summarize the WordPress PHPUnit timing markdown table into deterministic
rollup rows. By default rows are written to stdout. With --append, previous
rows for the selected label are replaced and the new rows are appended to the
input table.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --input)
      if [ "$#" -lt 2 ]; then
        echo "--input requires a path" >&2
        exit 2
      fi
      input="$2"
      shift 2
      ;;
    --append)
      append=1
      shift
      ;;
    --label)
      if [ "$#" -lt 2 ]; then
        echo "--label requires a value" >&2
        exit 2
      fi
      label="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "${input}" ]; then
  echo "No timing summary path supplied; use --input or MYLITE_WORDPRESS_TIMING_SUMMARY_PATH" >&2
  exit 2
fi
if [ ! -f "${input}" ]; then
  echo "Missing WordPress timing summary: ${input}" >&2
  exit 1
fi

rollup_tmp="$(mktemp "${TMPDIR:-/tmp}/mylite-wordpress-timing-rollup.XXXXXX")"
cleanup() {
  rm -f "${rollup_tmp}" "${filtered_tmp:-}"
}
trap cleanup EXIT

awk -v rollup_label="${label}" '
function trim(value) {
  sub(/^[[:space:]]+/, "", value)
  sub(/[[:space:]]+$/, "", value)
  return value
}

function is_number(value) {
  return value ~ /^-?[0-9]+([.][0-9]+)?$/
}

function add_sum(bucket, metric, value) {
  if (!is_number(value)) {
    return
  }
  sums[bucket SUBSEP metric] += value
  seen[bucket SUBSEP metric] = 1
}

function count_once(bucket, row_label, key) {
  key = bucket SUBSEP row_label
  if (!(key in counted)) {
    counted[key] = 1
    counts[bucket]++
  }
}

function metric_sum(bucket, metric) {
  return sums[bucket SUBSEP metric] + 0
}

function metric_seen(bucket, metric) {
  return (bucket SUBSEP metric) in seen
}

function row(metric, value) {
  printf "| %s | %s | %s |\n", rollup_label, metric, value
}

function row_int(metric, value) {
  row(metric, sprintf("%d", value))
}

function row_num(metric, value) {
  row(metric, sprintf("%.3f", value))
}

function note_max(metric, value, row_label) {
  if (!is_number(value)) {
    return
  }
  if (!(metric in max_seen) || value + 0 > max_values[metric]) {
    max_seen[metric] = 1
    max_values[metric] = value + 0
    max_labels[metric] = row_label
  }
}

function add_shard_phase(row_label, value, shard, phase) {
  if (!is_number(value)) {
    return
  }
  if (row_label ~ /^artifact-download-/) {
    shard = substr(row_label, length("artifact-download-") + 1)
    phase = "artifact_download"
  } else if (row_label ~ /^artifact-extract-/) {
    shard = substr(row_label, length("artifact-extract-") + 1)
    phase = "artifact_extract"
  } else if (row_label ~ /^docker-image-/) {
    shard = substr(row_label, length("docker-image-") + 1)
    phase = "docker_image"
  } else if (row_label ~ /^phpunit-/) {
    shard = substr(row_label, length("phpunit-") + 1)
    phase = "phpunit_total"
  } else {
    return
  }
  if (shard == "") {
    return
  }
  if (!(shard in shard_seen)) {
    shard_seen[shard] = 1
    shard_count++
  }
  shard_seconds[shard] += value + 0
  shard_phase_seconds[shard SUBSEP phase] += value + 0
  shard_phase_seen[shard SUBSEP phase] = 1
}

function add_shard_phpunit_shell(row_label, value, shard) {
  if (!is_number(value) || row_label !~ /^phpunit-/) {
    return
  }
  shard = substr(row_label, length("phpunit-") + 1)
  if (shard == "") {
    return
  }
  shard_phpunit_shell_seconds[shard] += value + 0
  shard_phase_seen[shard SUBSEP "phpunit_shell"] = 1
}

function shard_phase_value(shard, phase) {
  return shard_phase_seconds[shard SUBSEP phase] + 0
}

function shard_has_phase(shard, phase) {
  return (shard SUBSEP phase) in shard_phase_seen
}

function emit_sum(bucket, metric, output_metric) {
  if (metric_seen(bucket, metric)) {
    row_num(output_metric, metric_sum(bucket, metric))
  }
}

function emit_int_sum(bucket, metric, output_metric) {
  if (metric_seen(bucket, metric)) {
    row_int(output_metric, metric_sum(bucket, metric))
  }
}

function emit_ms_avg(bucket, numerator_metric, denominator_metric, output_metric, denominator) {
  if (!metric_seen(bucket, numerator_metric) || !metric_seen(bucket, denominator_metric)) {
    return
  }
  denominator = metric_sum(bucket, denominator_metric)
  if (denominator <= 0) {
    return
  }
  row_num(output_metric, (metric_sum(bucket, numerator_metric) * 1000.0) / denominator)
}

function emit_child_bucket(bucket, prefix) {
  emit_int_sum(bucket, "wordpress_phpunit_child_process_count", prefix "_child_process_count_sum")
  emit_int_sum(bucket, "wordpress_phpunit_child_process_closed_wpdbs", prefix "_child_process_closed_wpdbs_sum")
  emit_int_sum(bucket, "wordpress_phpunit_child_process_static_properties", prefix "_child_process_static_properties_sum")
  emit_int_sum(bucket, "wordpress_phpunit_child_process_skipped_static_properties", prefix "_child_process_skipped_static_properties_sum")
  emit_int_sum(bucket, "wordpress_phpunit_child_process_baseline_restore_count", prefix "_child_process_baseline_restore_count_sum")
  emit_sum(bucket, "wordpress_phpunit_child_process_baseline_restore_seconds", prefix "_child_process_baseline_restore_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_child_process_lock_release_seconds", prefix "_child_process_lock_release_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_child_process_runtime_seconds", prefix "_child_process_runtime_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_child_process_reconnect_seconds", prefix "_child_process_reconnect_seconds_sum")
  emit_int_sum(bucket, "wordpress_phpunit_child_script_count", prefix "_child_script_count_sum")
  emit_sum(bucket, "wordpress_phpunit_child_script_seconds", prefix "_child_script_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_child_process_outer_minus_script_seconds", prefix "_child_process_outer_minus_script_seconds_sum")
  emit_ms_avg(bucket, "wordpress_phpunit_child_process_baseline_restore_seconds", "wordpress_phpunit_child_process_baseline_restore_count", prefix "_child_process_baseline_restore_ms_avg")
  emit_ms_avg(bucket, "wordpress_phpunit_child_process_lock_release_seconds", "wordpress_phpunit_child_process_count", prefix "_child_process_lock_release_ms_avg")
  emit_ms_avg(bucket, "wordpress_phpunit_child_process_runtime_seconds", "wordpress_phpunit_child_process_count", prefix "_child_process_runtime_ms_avg")
  emit_ms_avg(bucket, "wordpress_phpunit_child_process_reconnect_seconds", "wordpress_phpunit_child_process_count", prefix "_child_process_reconnect_ms_avg")
  emit_ms_avg(bucket, "wordpress_phpunit_child_script_seconds", "wordpress_phpunit_child_script_count", prefix "_child_script_ms_avg")
  emit_ms_avg(bucket, "wordpress_phpunit_child_process_outer_minus_script_seconds", "wordpress_phpunit_child_process_count", prefix "_child_process_outer_minus_script_ms_avg")
}

function emit_bucket(bucket, prefix) {
  if (counts[bucket] <= 0) {
    return
  }
  row_int(prefix "_phase_count", counts[bucket])
  emit_sum(bucket, "wordpress_phpunit_shell_real_seconds", prefix "_shell_real_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_reported_seconds", prefix "_reported_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_shell_overhead_seconds", prefix "_shell_overhead_seconds_sum")
  emit_sum(bucket, "wordpress_phpunit_seconds", prefix "_seconds_sum")
  emit_sum(bucket, "wordpress_container_seconds", prefix "_container_seconds_sum")
  emit_sum(bucket, "wordpress_total_seconds", prefix "_total_seconds_sum")
  emit_child_bucket(bucket, prefix)
}

BEGIN {
  phpunit_metric["wordpress_phpunit_shell_real_seconds"] = 1
  phpunit_metric["wordpress_phpunit_reported_seconds"] = 1
  phpunit_metric["wordpress_phpunit_shell_overhead_seconds"] = 1
  phpunit_metric["wordpress_phpunit_seconds"] = 1
  phpunit_metric["wordpress_container_seconds"] = 1
  phpunit_metric["wordpress_total_seconds"] = 1
