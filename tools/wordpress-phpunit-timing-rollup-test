#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/mylite-wordpress-timing-rollup-test.XXXXXX")"
cleanup() {
  rm -rf "${tmp_dir}"
}
trap cleanup EXIT

summary="${tmp_dir}/timing-summary.md"
cat > "${summary}" <<'SUMMARY'
## WordPress PHPUnit Timing

| label | metric | value |
| --- | --- | ---: |
| docker-image | wordpress_docker_build_seconds | skipped |
| docker-image | wordpress_total_seconds | 29 |
| build-php | mylite_mariadb_embedded_seconds | 406 |
| build-php | mylite_php_configure_seconds | 2 |
| build-php | mylite_php_build_seconds | 14 |
| build-php | mylite_php_wrapper_seconds | 0 |
| build-php | mylite_build_seconds | 422 |
| build-php | wordpress_container_seconds | 422 |
| build-php | wordpress_total_seconds | 424 |
| perf-probe | wordpress_perf_summary_stock_php_process_start_ms_avg | 19.739 |
| perf-probe | wordpress_perf_summary_php_process_start_ms_avg | 26.912 |
| perf-probe | wordpress_perf_summary_php_extension_process_overhead_ms_avg | 7.173 |
| perf-probe | wordpress_perf_summary_mysqli_active_runtime_reconnect_ms_avg | 2.034 |
| perf-probe | wordpress_perf_summary_select1_ops_per_second | 1545.96 |
| phpunit-db | wordpress_phpunit_shell_real_seconds | 7.522 |
| phpunit-db | wordpress_phpunit_reported_seconds | 4.313 |
| phpunit-db | wordpress_phpunit_shell_overhead_seconds | 3.209 |
| phpunit-db | wordpress_phpunit_seconds | 7 |
| phpunit-db | wordpress_container_seconds | 9 |
| phpunit-db | wordpress_total_seconds | 10 |
| phpunit-db-profile | wordpress_phpunit_shell_real_seconds | 7.432 |
| phpunit-db-profile | wordpress_phpunit_reported_seconds | 4.223 |
| phpunit-db-profile | wordpress_phpunit_seconds | 8 |
| phpunit-deferred-reconnect-baseline-restored | wordpress_phpunit_shell_real_seconds | 26.917 |
| phpunit-deferred-reconnect-baseline-restored | wordpress_phpunit_reported_seconds | 23.823 |
| phpunit-deferred-reconnect-baseline-restored | wordpress_phpunit_seconds | 27 |
| phpunit-non-isolated-rest | wordpress_phpunit_shell_real_seconds | 168.469 |
| phpunit-non-isolated-rest | wordpress_phpunit_reported_seconds | 165.226 |
| phpunit-non-isolated-rest | wordpress_phpunit_seconds | 169 |
SUMMARY

rollup="$("${script_dir}/wordpress-phpunit-timing-rollup" --input "${summary}")"

require_row() {
  local expected="$1"
  if ! grep -Fqx "${expected}" <<<"${rollup}"; then
    echo "Missing rollup row: ${expected}" >&2
    echo "${rollup}" >&2
    exit 1
  fi
}

require_row "| timing-rollup | wordpress_phpunit_test_phase_count | 3 |"
require_row "| timing-rollup | wordpress_phpunit_test_shell_real_seconds_sum | 202.908 |"
require_row "| timing-rollup | wordpress_phpunit_test_reported_seconds_sum | 193.362 |"
require_row "| timing-rollup | wordpress_phpunit_test_seconds_sum | 203.000 |"
require_row "| timing-rollup | wordpress_phpunit_diagnostic_phase_count | 1 |"
require_row "| timing-rollup | wordpress_phpunit_diagnostic_shell_real_seconds_sum | 7.432 |"
require_row "| timing-rollup | wordpress_phpunit_all_phase_count | 4 |"
require_row "| timing-rollup | wordpress_phpunit_db_shell_real_seconds_sum | 7.522 |"
require_row "| timing-rollup | wordpress_phpunit_isolated_shell_real_seconds_sum | 26.917 |"
require_row "| timing-rollup | wordpress_phpunit_non_isolated_shell_real_seconds_sum | 168.469 |"
require_row "| timing-rollup | wordpress_build_mariadb_embedded_seconds | 406.000 |"
require_row "| timing-rollup | wordpress_build_total_seconds | 424.000 |"
require_row "| timing-rollup | wordpress_perf_php_extension_process_overhead_ms_avg | 7.173 |"
require_row "| timing-rollup | wordpress_perf_select1_ops_per_second | 1545.960 |"

"${script_dir}/wordpress-phpunit-timing-rollup" --input "${summary}" --append
"${script_dir}/wordpress-phpunit-timing-rollup" --input "${summary}" --append

rollup_count="$(grep -c '^| timing-rollup | wordpress_phpunit_test_phase_count | 3 |$' "${summary}")"
if [ "${rollup_count}" -ne 1 ]; then
  echo "Expected idempotent append to keep one rollup row, got ${rollup_count}" >&2
  exit 1
fi
