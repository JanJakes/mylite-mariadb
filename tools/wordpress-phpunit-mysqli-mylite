#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root_hash="$(printf '%s' "${root_dir}" | cksum | awk '{print $1}')"
image="${MYLITE_WORDPRESS_DOCKER_IMAGE:-mylite-wordpress-phpunit:php83}"
wordpress_repo="${MYLITE_WORDPRESS_REPO:-https://github.com/WordPress/wordpress-develop.git}"
wordpress_ref="${MYLITE_WORDPRESS_REF:-trunk}"
wordpress_dir="${MYLITE_WORDPRESS_DIR:-${root_dir}/build/wordpress-develop}"
phpunit_tools_dir="${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR:-${root_dir}/build/wordpress-phpunit-tools}"
mariadb_build_dir="${MYLITE_WORDPRESS_MARIADB_BUILD_DIR:-${root_dir}/build/wordpress-mariadb-embedded}"
cmake_build_dir="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR:-${root_dir}/build/wordpress-php-embedded}"
cmake_build_type="${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE:-Release}"
composer_cache_dir="${MYLITE_WORDPRESS_COMPOSER_CACHE_DIR:-${root_dir}/build/wordpress-composer-cache}"
phpunit_report_dir="${MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR:-${root_dir}/build/wordpress-phpunit-reports}"
timing_summary_path="${MYLITE_WORDPRESS_TIMING_SUMMARY_PATH:-${phpunit_report_dir}/timing-summary.md}"
runtime_manifest_path="${MYLITE_WORDPRESS_RUNTIME_MANIFEST_PATH:-}"
runtime_metadata_path="${MYLITE_WORDPRESS_RUNTIME_METADATA_PATH:-}"
trust_runtime_manifest="${MYLITE_WORDPRESS_TRUST_RUNTIME_MANIFEST:-0}"
runtime_expected_github_sha="${MYLITE_WORDPRESS_RUNTIME_EXPECTED_GITHUB_SHA:-${GITHUB_SHA:-}}"
runtime_expected_wordpress_ref="${MYLITE_WORDPRESS_RUNTIME_EXPECTED_WORDPRESS_REF:-${wordpress_ref}}"
phpunit_log_junit="${MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT:-0}"
phpunit_no_logging="${MYLITE_WORDPRESS_PHPUNIT_NO_LOGGING:-0}"
phpunit_slow_report_limit="${MYLITE_WORDPRESS_PHPUNIT_SLOW_REPORT_LIMIT:-20}"
phpunit_profile_child_processes="${MYLITE_WORDPRESS_PHPUNIT_PROFILE_CHILD_PROCESSES:-0}"
phpunit_child_timing_summary="${MYLITE_WORDPRESS_PHPUNIT_CHILD_TIMING_SUMMARY:-0}"
phpunit_child_script_timing_summary="${MYLITE_WORDPRESS_PHPUNIT_CHILD_SCRIPT_TIMING_SUMMARY:-0}"
phpunit_profile_mysqli="${MYLITE_WORDPRESS_PHPUNIT_PROFILE_MYSQLI:-0}"
phpunit_keepalive="${MYLITE_WORDPRESS_PHPUNIT_KEEPALIVE:-0}"
phpunit_static_wpdb_scan="${MYLITE_WORDPRESS_PHPUNIT_STATIC_WPDB_SCAN:-0}"
phpunit_reconnect_after_child="${MYLITE_WORDPRESS_PHPUNIT_RECONNECT_AFTER_CHILD:-1}"
phpunit_child_skip_install="${MYLITE_WORDPRESS_PHPUNIT_CHILD_SKIP_INSTALL:-0}"
phpunit_child_restore_baseline="${MYLITE_WORDPRESS_PHPUNIT_CHILD_RESTORE_BASELINE:-0}"
phpunit_skip_install="${MYLITE_WORDPRESS_PHPUNIT_SKIP_INSTALL:-0}"
preserve_timing_summary="${MYLITE_WORDPRESS_PRESERVE_TIMING_SUMMARY:-0}"
require_release_build="${MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD:-0}"
require_external_db_dir="${MYLITE_WORDPRESS_REQUIRE_EXTERNAL_DB_DIR:-0}"
db_dir="${MYLITE_WORDPRESS_DB_DIR:-${TMPDIR:-/tmp}/mylite-wordpress-tests-${root_hash}.mylite}"
db_baseline_dir="${MYLITE_WORDPRESS_DB_BASELINE_DIR:-${db_dir}.baseline}"
build_targets="${MYLITE_WORDPRESS_BUILD_TARGETS:-mylite_php_extension mylite_mysqli_php_extension}"
phase="${MYLITE_WORDPRESS_PHASE:-all}"
timing_label="${MYLITE_WORDPRESS_TIMING_LABEL:-${phase}}"
skip_docker_build="${MYLITE_WORDPRESS_SKIP_DOCKER_BUILD:-0}"
case "${phase}" in
  all | docker-image | setup | fetch | build-php | dependencies | prepare-db | phpunit | perf-probe)
    ;;
  *)
    echo "Unsupported MYLITE_WORDPRESS_PHASE='${phase}'" >&2
    echo "Supported phases: all, docker-image, setup, fetch, build-php, dependencies, prepare-db, phpunit, perf-probe" >&2
    exit 1
    ;;
esac
case "${skip_docker_build}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_SKIP_DOCKER_BUILD must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${require_release_build}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${require_external_db_dir}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_REQUIRE_EXTERNAL_DB_DIR must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${trust_runtime_manifest}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_TRUST_RUNTIME_MANIFEST must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_log_junit}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_no_logging}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_NO_LOGGING must be 0 or 1" >&2
    exit 1
    ;;
esac
if [[ "${phpunit_log_junit}" == "1" && "${phpunit_no_logging}" == "1" ]]; then
  echo "MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT=1 requires MYLITE_WORDPRESS_PHPUNIT_NO_LOGGING=0" >&2
  exit 1
fi
case "${phpunit_slow_report_limit}" in
  '' | *[!0-9]*)
    echo "MYLITE_WORDPRESS_PHPUNIT_SLOW_REPORT_LIMIT must be a positive integer" >&2
    exit 1
    ;;
  *)
    if [ "${phpunit_slow_report_limit}" -le 0 ]; then
      echo "MYLITE_WORDPRESS_PHPUNIT_SLOW_REPORT_LIMIT must be a positive integer" >&2
      exit 1
    fi
    ;;
esac
case "${phpunit_static_wpdb_scan}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_STATIC_WPDB_SCAN must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_profile_child_processes}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_PROFILE_CHILD_PROCESSES must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_child_timing_summary}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_CHILD_TIMING_SUMMARY must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_child_script_timing_summary}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_CHILD_SCRIPT_TIMING_SUMMARY must be 0 or 1" >&2
    exit 1
    ;;
esac
if [[ "${phpunit_child_script_timing_summary}" == "1" &&
      "${phpunit_child_timing_summary}" == "0" &&
      "${phpunit_profile_child_processes}" == "0" ]]; then
  echo "MYLITE_WORDPRESS_PHPUNIT_CHILD_SCRIPT_TIMING_SUMMARY=1 requires child timing summary or child profiling" >&2
  exit 1
fi
case "${phpunit_profile_mysqli}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_PROFILE_MYSQLI must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_keepalive}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_KEEPALIVE must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_reconnect_after_child}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_RECONNECT_AFTER_CHILD must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_child_skip_install}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_CHILD_SKIP_INSTALL must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_child_restore_baseline}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_CHILD_RESTORE_BASELINE must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${phpunit_skip_install}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PHPUNIT_SKIP_INSTALL must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${preserve_timing_summary}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_PRESERVE_TIMING_SUMMARY must be 0 or 1" >&2
    exit 1
    ;;
esac
if [[ "${phpunit_child_restore_baseline}" == "1" &&
      ( "${phpunit_child_skip_install}" != "1" || "${phpunit_skip_install}" != "1" ) ]]; then
  echo "MYLITE_WORDPRESS_PHPUNIT_CHILD_RESTORE_BASELINE=1 requires child and parent skip-install" >&2
  exit 1
fi
if [[ "${phase}" == "docker-image" && "${skip_docker_build}" == "1" ]]; then
  echo "MYLITE_WORDPRESS_PHASE=docker-image cannot skip the Docker build" >&2
  exit 1
fi

normalize_root_dir() {
  local env_name="$1"
  local path="$2"
  local basename
  local parent

  if [[ "${path}" != /* ]]; then
    path="${root_dir}/${path}"
  fi
  basename="$(basename "${path}")"
  parent="$(mkdir -p "$(dirname "${path}")" && cd "$(dirname "${path}")" && pwd)"
  path="${parent}/${basename}"
  if [[ "${path}" != "${root_dir}" && "${path}" != "${root_dir}"/* ]]; then
    echo "${env_name} must be inside ${root_dir}: ${path}" >&2
    exit 1
  fi
  printf '%s\n' "${path}"
}

wordpress_dir="$(normalize_root_dir MYLITE_WORDPRESS_DIR "${wordpress_dir}")"
phpunit_tools_dir="$(normalize_root_dir MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR "${phpunit_tools_dir}")"
mariadb_build_dir="$(normalize_root_dir MYLITE_WORDPRESS_MARIADB_BUILD_DIR "${mariadb_build_dir}")"
cmake_build_dir="$(normalize_root_dir MYLITE_WORDPRESS_CMAKE_BUILD_DIR "${cmake_build_dir}")"
composer_cache_dir="$(normalize_root_dir MYLITE_WORDPRESS_COMPOSER_CACHE_DIR "${composer_cache_dir}")"
phpunit_report_dir="$(normalize_root_dir MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR "${phpunit_report_dir}")"
timing_summary_path="$(normalize_root_dir MYLITE_WORDPRESS_TIMING_SUMMARY_PATH "${timing_summary_path}")"
if [ -n "${runtime_manifest_path}" ]; then
  runtime_manifest_path="$(
    normalize_root_dir MYLITE_WORDPRESS_RUNTIME_MANIFEST_PATH "${runtime_manifest_path}"
  )"
fi
if [ -n "${runtime_metadata_path}" ]; then
  runtime_metadata_path="$(
    normalize_root_dir MYLITE_WORDPRESS_RUNTIME_METADATA_PATH "${runtime_metadata_path}"
  )"
fi

if [[ "${db_dir}" != /* ]]; then
  db_dir="${root_dir}/${db_dir}"
fi
db_parent_dir="$(mkdir -p "$(dirname "${db_dir}")" && cd "$(dirname "${db_dir}")" && pwd)"
db_basename="$(basename "${db_dir}")"
db_dir="${db_parent_dir}/${db_basename}"
if [[ "${db_baseline_dir}" != /* ]]; then
  db_baseline_dir="${root_dir}/${db_baseline_dir}"
fi
db_baseline_parent_dir="$(mkdir -p "$(dirname "${db_baseline_dir}")" && cd "$(dirname "${db_baseline_dir}")" && pwd)"
db_baseline_basename="$(basename "${db_baseline_dir}")"
db_baseline_dir="${db_baseline_parent_dir}/${db_baseline_basename}"
if [[ "${db_baseline_dir}" == "${db_dir}" ||
      "${db_baseline_dir}" == "${db_dir}"/* ||
      "${db_dir}" == "${db_baseline_dir}"/* ]]; then
  echo "MYLITE_WORDPRESS_DB_BASELINE_DIR must be separate from MYLITE_WORDPRESS_DB_DIR." >&2
  echo "MYLITE_WORDPRESS_DB_DIR=${db_dir}" >&2
  echo "MYLITE_WORDPRESS_DB_BASELINE_DIR=${db_baseline_dir}" >&2
  exit 1
fi
if [[ "${require_external_db_dir}" == "1" &&
      ( "${db_dir}" == "${root_dir}" || "${db_dir}" == "${root_dir}"/* ) ]]; then
  echo "MYLITE_WORDPRESS_REQUIRE_EXTERNAL_DB_DIR requires MYLITE_WORDPRESS_DB_DIR outside ${root_dir}." >&2
  echo "Current MYLITE_WORDPRESS_DB_DIR=${db_dir}" >&2
  exit 1
fi
if [[ "${require_external_db_dir}" == "1" &&
      ( "${db_baseline_dir}" == "${root_dir}" || "${db_baseline_dir}" == "${root_dir}"/* ) ]]; then
  echo "MYLITE_WORDPRESS_REQUIRE_EXTERNAL_DB_DIR requires MYLITE_WORDPRESS_DB_BASELINE_DIR outside ${root_dir}." >&2
  echo "Current MYLITE_WORDPRESS_DB_BASELINE_DIR=${db_baseline_dir}" >&2
  exit 1
fi
if [[ "${db_dir}" != "${root_dir}"/* &&
      "${db_baseline_parent_dir}" != "${db_parent_dir}" ]]; then
  echo "External MYLITE_WORDPRESS_DB_BASELINE_DIR must share MYLITE_WORDPRESS_DB_DIR's parent directory." >&2
  echo "MYLITE_WORDPRESS_DB_DIR=${db_dir}" >&2
  echo "MYLITE_WORDPRESS_DB_BASELINE_DIR=${db_baseline_dir}" >&2
  exit 1
fi
if [[ "${db_dir}" == "${root_dir}"/* &&
      "${db_baseline_dir}" != "${root_dir}"/* ]]; then
  echo "Repository-local MYLITE_WORDPRESS_DB_DIR requires MYLITE_WORDPRESS_DB_BASELINE_DIR inside ${root_dir}." >&2
  echo "MYLITE_WORDPRESS_DB_DIR=${db_dir}" >&2
  echo "MYLITE_WORDPRESS_DB_BASELINE_DIR=${db_baseline_dir}" >&2
  exit 1
fi
composer_cache_dir="$(mkdir -p "${composer_cache_dir}" && cd "${composer_cache_dir}" && pwd)"
phpunit_report_dir="$(mkdir -p "${phpunit_report_dir}" && cd "${phpunit_report_dir}" && pwd)"
container_root="/work"
container_wordpress_dir="${container_root}${wordpress_dir#"${root_dir}"}"
container_phpunit_tools_dir="${container_root}${phpunit_tools_dir#"${root_dir}"}"
container_mariadb_build_dir="${container_root}${mariadb_build_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"
container_composer_cache_dir="${container_root}${composer_cache_dir#"${root_dir}"}"
container_phpunit_report_dir="${container_root}${phpunit_report_dir#"${root_dir}"}"
container_timing_summary_path="${container_root}${timing_summary_path#"${root_dir}"}"
db_mount_args=()
if [[ "${db_dir}" == "${root_dir}"/* ]]; then
  container_db_dir="${container_root}${db_dir#"${root_dir}"}"
  container_db_baseline_dir="${container_root}${db_baseline_dir#"${root_dir}"}"
else
  container_db_parent="/mylite-wordpress-db"
  container_db_dir="${container_db_parent}/${db_basename}"
  container_db_baseline_dir="${container_db_parent}/${db_baseline_basename}"
  db_mount_args=(-v "${db_parent_dir}:${container_db_parent}")
fi

host_seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

host_markdown_cell() {
  local value="$1"
  value="${value//$'\n'/ }"
  value="${value//|/\\|}"
  printf '%s' "${value}"
}

host_append_timing_summary() {
  local metric
  local value
  local escaped_label
  local escaped_metric
  local escaped_value

  mkdir -p "$(dirname "${timing_summary_path}")"
  if [ ! -s "${timing_summary_path}" ]; then
    {
      echo "## WordPress PHPUnit Timing"
      echo
      echo "| label | metric | value |"
      echo "| --- | --- | ---: |"
    } > "${timing_summary_path}"
  fi

  escaped_label="$(host_markdown_cell "${timing_label}")"
  for metric in "$@"; do
    value="${metric#*=}"
    metric="${metric%%=*}"
    escaped_metric="$(host_markdown_cell "${metric}")"
    escaped_value="$(host_markdown_cell "${value}")"
    printf '| %s | %s | %s |\n' \
      "${escaped_label}" \
      "${escaped_metric}" \
      "${escaped_value}" \
      >> "${timing_summary_path}"
  done
}

host_find_newer_first_party_source() {
  local artifact="$1"
  local source_group="$2"
  local -a candidates
  local candidate
  local newer_source

  case "${source_group}" in
    libmylite)
      candidates=(
        "${root_dir}/CMakeLists.txt"
        "${root_dir}/packages/libmylite/CMakeLists.txt"
        "${root_dir}/cmake"
        "${root_dir}/packages/libmylite/include"
        "${root_dir}/packages/libmylite/src"
      )
      ;;
    mylite-extension)
      candidates=(
        "${root_dir}/CMakeLists.txt"
        "${root_dir}/packages/php-ext-mylite/CMakeLists.txt"
        "${root_dir}/cmake"
        "${root_dir}/packages/php-ext-mylite/src"
        "${cmake_build_dir}/packages/libmylite/libmylite.a"
      )
      ;;
    mysqli-extension)
      candidates=(
        "${root_dir}/CMakeLists.txt"
        "${root_dir}/packages/php-ext-mysqli-mylite/CMakeLists.txt"
        "${root_dir}/cmake"
        "${root_dir}/packages/libmylite/include"
        "${root_dir}/packages/php-ext-mysqli-mylite/src"
      )
      ;;
    *)
      echo "Unknown WordPress freshness source group: ${source_group}" >&2
      exit 1
      ;;
  esac

  for candidate in "${candidates[@]}"; do
    if [ -f "${candidate}" ] && [ "${candidate}" -nt "${artifact}" ]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
    if [ -d "${candidate}" ]; then
      newer_source="$(
        find "${candidate}" -type f \
          \( \
            -name '*.c' -o \
            -name '*.cc' -o \
            -name '*.cpp' -o \
            -name '*.h' -o \
            -name '*.hpp' -o \
            -name '*.cmake' -o \
            -name 'CMakeLists.txt' \
          \) \
          -newer "${artifact}" \
          -print \
          -quit
      )"
      if [ -n "${newer_source}" ]; then
        printf '%s\n' "${newer_source}"
        return 0
      fi
    fi
  done
  return 1
}

host_require_fresh_artifact() {
  local artifact="$1"
  local description="$2"
  local source_group="$3"
  local newer_source

  if [ ! -e "${artifact}" ]; then
    echo "Missing ${description}: ${artifact}" >&2
    echo "Run MYLITE_WORDPRESS_PHASE=build-php before MYLITE_WORDPRESS_PHASE=${phase}." >&2
    exit 1
  fi

  newer_source="$(host_find_newer_first_party_source "${artifact}" "${source_group}" || true)"
  if [ -n "${newer_source}" ]; then
    echo "Stale ${description}: ${artifact} is older than ${newer_source}." >&2
    echo "Run MYLITE_WORDPRESS_PHASE=build-php before MYLITE_WORDPRESS_PHASE=${phase}." >&2
    exit 1
  fi
}

host_require_wordpress_php_artifacts_fresh() {
  local mariadb_archive

  case "${phase}" in
    prepare-db | phpunit | perf-probe)
      ;;
    *)
      return
      ;;
  esac

  if [ "${trust_runtime_manifest}" = "1" ]; then
    host_require_runtime_manifest
    echo "wordpress_php_artifact_manifest_ok=${runtime_manifest_path}"
    host_append_timing_summary "wordpress_php_artifact_manifest_ok=${runtime_manifest_path}"
    return
  fi

  mariadb_archive="${mariadb_build_dir}/libmysqld/libmariadbd.a"
  cmake \
    "-DMYLITE_MARIADB_SOURCE_DIR=${root_dir}/mariadb" \
    "-DMYLITE_MARIADB_ARCHIVE=${mariadb_archive}" \
    "-DMYLITE_MARIADB_PROFILE=${root_dir}/cmake/mariadb-embedded-baseline.cmake" \
    -P "${root_dir}/cmake/check-mariadb-embedded-freshness.cmake"

  host_require_fresh_artifact \
    "${cmake_build_dir}/packages/libmylite/libmylite.a" \
    "WordPress libmylite archive" \
    libmylite
  host_require_fresh_artifact \
    "${cmake_build_dir}/packages/php-ext-mylite/mylite.so" \
    "WordPress mylite PHP extension" \
    mylite-extension
  host_require_fresh_artifact \
    "${cmake_build_dir}/packages/php-ext-mysqli-mylite/mysqli_mylite.so" \
    "WordPress mysqli_mylite PHP extension" \
    mysqli-extension

  echo "wordpress_php_artifact_freshness_ok=${cmake_build_dir}"
  host_append_timing_summary "wordpress_php_artifact_freshness_ok=${cmake_build_dir}"
}

host_require_manifest_field() {
  local key="$1"
  local expected="$2"

  if [ -z "${expected}" ]; then
    return
  fi
  if [ -z "${runtime_metadata_path}" ]; then
    echo "MYLITE_WORDPRESS_RUNTIME_METADATA_PATH is required to validate ${key}" >&2
    exit 1
  fi
  if ! grep -Fxq -- "${key}=${expected}" "${runtime_metadata_path}"; then
    echo "Runtime manifest metadata mismatch for ${key}" >&2
    echo "Expected ${key}=${expected}" >&2
    echo "Metadata file: ${runtime_metadata_path}" >&2
    exit 1
  fi
}

host_require_runtime_manifest() {
  if [ -z "${runtime_manifest_path}" ]; then
    echo "MYLITE_WORDPRESS_TRUST_RUNTIME_MANIFEST=1 requires MYLITE_WORDPRESS_RUNTIME_MANIFEST_PATH" >&2
    exit 1
  fi
  if [ ! -s "${runtime_manifest_path}" ]; then
    echo "Missing runtime manifest: ${runtime_manifest_path}" >&2
    exit 1
  fi
  if [ -n "${runtime_metadata_path}" ] && [ ! -s "${runtime_metadata_path}" ]; then
    echo "Missing runtime manifest metadata: ${runtime_metadata_path}" >&2
    exit 1
  fi

  (
    cd "${root_dir}"
    sha256sum -c "${runtime_manifest_path}"
  )
  host_require_manifest_field "github_sha" "${runtime_expected_github_sha}"
  host_require_manifest_field "wordpress_ref" "${runtime_expected_wordpress_ref}"
  host_require_manifest_field "mariadb_cmake_build_type" "MinSizeRel"
  host_require_manifest_field "mylite_cmake_build_type" "${cmake_build_type}"
}

build_image() {
  docker build \
    -t "${image}" \
    -f "${root_dir}/tools/wordpress-phpunit.Dockerfile" \
    "${root_dir}/tools"
}

