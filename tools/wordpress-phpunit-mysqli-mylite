#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root_hash="$(printf '%s' "${root_dir}" | cksum | awk '{print $1}')"
image="${MYLITE_WORDPRESS_DOCKER_IMAGE:-mylite-wordpress-phpunit:php83}"
wordpress_repo="${MYLITE_WORDPRESS_REPO:-https://github.com/WordPress/wordpress-develop.git}"
wordpress_ref="${MYLITE_WORDPRESS_REF:-trunk}"
wordpress_dir="${MYLITE_WORDPRESS_DIR:-${root_dir}/build/wordpress-develop}"
phpunit_tools_dir="${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR:-${root_dir}/build/wordpress-phpunit-tools}"
mariadb_build_dir="${MYLITE_WORDPRESS_MARIADB_BUILD_DIR:-${root_dir}/build/wordpress-mariadb-embedded}"
cmake_build_dir="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR:-${root_dir}/build/wordpress-php-embedded}"
cmake_build_type="${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE:-Release}"
composer_cache_dir="${MYLITE_WORDPRESS_COMPOSER_CACHE_DIR:-${root_dir}/build/wordpress-composer-cache}"
phpunit_report_dir="${MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR:-${root_dir}/build/wordpress-phpunit-reports}"
phpunit_log_junit="${MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT:-0}"
phpunit_profile_child_processes="${MYLITE_WORDPRESS_PHPUNIT_PROFILE_CHILD_PROCESSES:-1}"
require_release_build="${MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD:-0}"
db_dir="${MYLITE_WORDPRESS_DB_DIR:-${TMPDIR:-/tmp}/mylite-wordpress-tests-${root_hash}.mylite}"
build_targets="${MYLITE_WORDPRESS_BUILD_TARGETS:-mylite_php_extension mylite_mysqli_php_extension}"
phase="${MYLITE_WORDPRESS_PHASE:-all}"
skip_docker_build="${MYLITE_WORDPRESS_SKIP_DOCKER_BUILD:-0}"
case "${phase}" in
  all | docker-image | setup | fetch | build-php | dependencies | prepare-db | phpunit | perf-probe)
    ;;
  *)
    echo "Unsupported MYLITE_WORDPRESS_PHASE='${phase}'" >&2
    echo "Supported phases: all, docker-image, setup, fetch, build-php, dependencies, prepare-db, phpunit, perf-probe" >&2
    exit 1
    ;;
esac
case "${skip_docker_build}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_SKIP_DOCKER_BUILD must be 0 or 1" >&2
    exit 1
    ;;
esac
case "${require_release_build}" in
  0 | 1)
    ;;
  *)
    echo "MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD must be 0 or 1" >&2
    exit 1
    ;;
esac
if [[ "${phase}" == "docker-image" && "${skip_docker_build}" == "1" ]]; then
  echo "MYLITE_WORDPRESS_PHASE=docker-image cannot skip the Docker build" >&2
  exit 1
fi

normalize_root_dir() {
  local env_name="$1"
  local path="$2"
  local basename
  local parent

  if [[ "${path}" != /* ]]; then
    path="${root_dir}/${path}"
  fi
  basename="$(basename "${path}")"
  parent="$(mkdir -p "$(dirname "${path}")" && cd "$(dirname "${path}")" && pwd)"
  path="${parent}/${basename}"
  if [[ "${path}" != "${root_dir}" && "${path}" != "${root_dir}"/* ]]; then
    echo "${env_name} must be inside ${root_dir}: ${path}" >&2
    exit 1
  fi
  printf '%s\n' "${path}"
}

wordpress_dir="$(normalize_root_dir MYLITE_WORDPRESS_DIR "${wordpress_dir}")"
phpunit_tools_dir="$(normalize_root_dir MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR "${phpunit_tools_dir}")"
mariadb_build_dir="$(normalize_root_dir MYLITE_WORDPRESS_MARIADB_BUILD_DIR "${mariadb_build_dir}")"
cmake_build_dir="$(normalize_root_dir MYLITE_WORDPRESS_CMAKE_BUILD_DIR "${cmake_build_dir}")"
composer_cache_dir="$(normalize_root_dir MYLITE_WORDPRESS_COMPOSER_CACHE_DIR "${composer_cache_dir}")"
phpunit_report_dir="$(normalize_root_dir MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR "${phpunit_report_dir}")"

if [[ "${db_dir}" != /* ]]; then
  db_dir="${root_dir}/${db_dir}"
fi
db_parent_dir="$(mkdir -p "$(dirname "${db_dir}")" && cd "$(dirname "${db_dir}")" && pwd)"
db_basename="$(basename "${db_dir}")"
db_dir="${db_parent_dir}/${db_basename}"
composer_cache_dir="$(mkdir -p "${composer_cache_dir}" && cd "${composer_cache_dir}" && pwd)"
phpunit_report_dir="$(mkdir -p "${phpunit_report_dir}" && cd "${phpunit_report_dir}" && pwd)"
container_root="/work"
container_wordpress_dir="${container_root}${wordpress_dir#"${root_dir}"}"
container_phpunit_tools_dir="${container_root}${phpunit_tools_dir#"${root_dir}"}"
container_mariadb_build_dir="${container_root}${mariadb_build_dir#"${root_dir}"}"
container_cmake_build_dir="${container_root}${cmake_build_dir#"${root_dir}"}"
container_composer_cache_dir="${container_root}${composer_cache_dir#"${root_dir}"}"
container_phpunit_report_dir="${container_root}${phpunit_report_dir#"${root_dir}"}"
db_mount_args=()
if [[ "${db_dir}" == "${root_dir}"/* ]]; then
  container_db_dir="${container_root}${db_dir#"${root_dir}"}"
else
  container_db_parent="/mylite-wordpress-db"
  container_db_dir="${container_db_parent}/${db_basename}"
  db_mount_args=(-v "${db_parent_dir}:${container_db_parent}")
fi

host_seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

build_image() {
  docker build -t "${image}" - <<'DOCKERFILE'
FROM composer:2 AS composer
FROM php:8.3-cli-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bison \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libavif-dev \
    libcrypt-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libncurses-dev \
    libpcre2-dev \
    libpng-dev \
    libssl-dev \
    libwebp-dev \
    libzip-dev \
    ninja-build \
    pkg-config \
    unzip \
    zlib1g-dev \
  && docker-php-ext-configure gd --with-avif --with-freetype --with-jpeg --with-webp \
  && docker-php-ext-install -j"$(nproc)" gd zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
DOCKERFILE
}

run_suite() {
  docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp/mylite-home \
    -e MYLITE_WORDPRESS_REPO="${wordpress_repo}" \
    -e MYLITE_WORDPRESS_REF="${wordpress_ref}" \
    -e MYLITE_WORDPRESS_DIR="${container_wordpress_dir}" \
    -e MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR="${container_phpunit_tools_dir}" \
    -e MYLITE_WORDPRESS_MARIADB_BUILD_DIR="${container_mariadb_build_dir}" \
    -e MYLITE_WORDPRESS_CMAKE_BUILD_DIR="${container_cmake_build_dir}" \
    -e MYLITE_WORDPRESS_CMAKE_BUILD_TYPE="${cmake_build_type}" \
    -e MYLITE_WORDPRESS_COMPOSER_CACHE_DIR="${container_composer_cache_dir}" \
    -e MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR="${container_phpunit_report_dir}" \
    -e MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT="${phpunit_log_junit}" \
    -e MYLITE_WORDPRESS_PHPUNIT_PROFILE_CHILD_PROCESSES="${phpunit_profile_child_processes}" \
    -e MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD="${require_release_build}" \
    -e MYLITE_WORDPRESS_DB_DIR="${container_db_dir}" \
    -e MYLITE_WORDPRESS_BUILD_TARGETS="${build_targets}" \
    -e MYLITE_WORDPRESS_PHASE="${phase}" \
    -e MYLITE_WORDPRESS_PERF_PROCESS_ITERATIONS="${MYLITE_WORDPRESS_PERF_PROCESS_ITERATIONS:-5}" \
    -e MYLITE_WORDPRESS_PERF_CONNECT_ITERATIONS="${MYLITE_WORDPRESS_PERF_CONNECT_ITERATIONS:-${MYLITE_WORDPRESS_PERF_PROCESS_ITERATIONS:-5}}" \
    -e MYLITE_WORDPRESS_PERF_SQL_ITERATIONS="${MYLITE_WORDPRESS_PERF_SQL_ITERATIONS:-5000}" \
    -e MYLITE_WORDPRESS_PERF_WRITE_ITERATIONS="${MYLITE_WORDPRESS_PERF_WRITE_ITERATIONS:-1000}" \
    -e COMPOSER_CACHE_DIR="${container_composer_cache_dir}" \
    -v "${root_dir}:${container_root}" \
    "${db_mount_args[@]}" \
    -w "${container_root}" \
    "${image}" \
    bash -s -- "$@" <<'CONTAINER'
set -euo pipefail

php_wrapper="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}/mylite-wordpress-php"
mylite_extension="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}/packages/php-ext-mylite/mylite.so"
mysqli_extension="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}/packages/php-ext-mysqli-mylite/mysqli_mylite.so"
php_ini_dir="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}/php-conf.d"
wordpress_db_parent_dir="$(dirname "${MYLITE_WORDPRESS_DB_DIR}")"

phase() {
  printf '\n==> %s\n' "$*"
}

seconds_since() {
  local start="$1"
  local end
  end="$(date +%s)"
  echo "$((end - start))"
}

require_path() {
  local path="$1"
  local phase_name="$2"
  local description="$3"
  if [ ! -e "${path}" ]; then
    echo "Missing ${description}: ${path}" >&2
    echo "Run MYLITE_WORDPRESS_PHASE=${phase_name} before MYLITE_WORDPRESS_PHASE=${MYLITE_WORDPRESS_PHASE}." >&2
    exit 1
  fi
}

require_executable() {
  local path="$1"
  local phase_name="$2"
  local description="$3"
  if [ ! -x "${path}" ]; then
    echo "Missing executable ${description}: ${path}" >&2
    echo "Run MYLITE_WORDPRESS_PHASE=${phase_name} before MYLITE_WORDPRESS_PHASE=${MYLITE_WORDPRESS_PHASE}." >&2
    exit 1
  fi
}

require_requested_build_type() {
  if [ "${MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD}" = "1" ] &&
     [ "${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE}" != "Release" ]; then
    echo "MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD requires MYLITE_WORDPRESS_CMAKE_BUILD_TYPE=Release." >&2
    echo "Current MYLITE_WORDPRESS_CMAKE_BUILD_TYPE=${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE}" >&2
    exit 1
  fi
}

require_matching_cmake_build_type() {
  local cache
  local cached_type

  cache="${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}/CMakeCache.txt"
  require_path "${cache}" build-php "CMake cache"
  cached_type="$(
    sed -n 's/^CMAKE_BUILD_TYPE:[^=]*=//p' "${cache}" |
      tail -n 1
  )"
  if [ -z "${cached_type}" ]; then
    echo "Could not read CMAKE_BUILD_TYPE from ${cache}" >&2
    exit 1
  fi
  if [ "${cached_type}" != "${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE}" ]; then
    echo "WordPress MyLite build type mismatch for ${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}." >&2
    echo "Configured MYLITE_WORDPRESS_CMAKE_BUILD_TYPE=${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE}, CMake cache has ${cached_type}." >&2
    echo "Run MYLITE_WORDPRESS_PHASE=build-php before MYLITE_WORDPRESS_PHASE=${MYLITE_WORDPRESS_PHASE}." >&2
    exit 1
  fi
  if [ "${MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD}" = "1" ] &&
     [ "${cached_type}" != "Release" ]; then
    echo "WordPress CI timing phases require a Release build, but ${cache} has ${cached_type}." >&2
    exit 1
  fi
}

require_mariadb_embedded_production_build_type() {
  local cache
  local cached_type

  if [ "${MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD}" != "1" ]; then
    return
  fi

  cache="${MYLITE_WORDPRESS_MARIADB_BUILD_DIR}/CMakeCache.txt"
  require_path "${cache}" build-php "MariaDB embedded CMake cache"
  cached_type="$(
    sed -n 's/^CMAKE_BUILD_TYPE:[^=]*=//p' "${cache}" |
      tail -n 1
  )"
  if [ -z "${cached_type}" ]; then
    echo "Could not read CMAKE_BUILD_TYPE from ${cache}" >&2
    exit 1
  fi
  if [ "${cached_type}" != "MinSizeRel" ]; then
    echo "WordPress CI timing phases require a MinSizeRel MariaDB embedded archive, but ${cache} has ${cached_type}." >&2
    exit 1
  fi
}

require_build_php_artifacts() {
  require_requested_build_type
  require_executable "${php_wrapper}" build-php "PHP wrapper"
  require_path "${mylite_extension}" build-php "mylite PHP extension"
  require_path "${mysqli_extension}" build-php "mysqli_mylite PHP extension"
  require_path "${php_ini_dir}/mylite.ini" build-php "PHP extension ini"
  require_matching_cmake_build_type
  require_mariadb_embedded_production_build_type
}

require_phpunit_artifacts() {
  require_path "${MYLITE_WORDPRESS_DIR}/.git" fetch "WordPress checkout"
  require_executable \
    "${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}/vendor/bin/phpunit" \
    dependencies \
    "PHPUnit binary"
  require_path "${MYLITE_WORDPRESS_DIR}/vendor/autoload.php" dependencies "WordPress Composer install"
}

require_prepared_database() {
  require_path "${MYLITE_WORDPRESS_DIR}/wp-tests-config.php" prepare-db "WordPress test config"
  require_path "${MYLITE_WORDPRESS_DB_DIR}" prepare-db "prepared MyLite database directory"
}

mkdir -p \
  "${HOME}" \
  "$(dirname "${MYLITE_WORDPRESS_DIR}")" \
  "${MYLITE_WORDPRESS_COMPOSER_CACHE_DIR}" \
  "${MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR}" \
  "${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}" \
  "${wordpress_db_parent_dir}"

phase "Show WordPress harness resources"
echo "wordpress_phase=${MYLITE_WORDPRESS_PHASE}"
echo "wordpress_ref=${MYLITE_WORDPRESS_REF}"
echo "wordpress_dir=${MYLITE_WORDPRESS_DIR}"
echo "wordpress_phpunit_tools_dir=${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}"
echo "wordpress_mariadb_build_dir=${MYLITE_WORDPRESS_MARIADB_BUILD_DIR}"
echo "wordpress_cmake_build_dir=${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}"
echo "wordpress_cmake_build_type=${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE}"
echo "wordpress_composer_cache_dir=${MYLITE_WORDPRESS_COMPOSER_CACHE_DIR}"
echo "wordpress_phpunit_report_dir=${MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR}"
echo "wordpress_phpunit_log_junit=${MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT}"
echo "wordpress_phpunit_profile_child_processes=${MYLITE_WORDPRESS_PHPUNIT_PROFILE_CHILD_PROCESSES}"
echo "wordpress_require_release_build=${MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD}"
echo "wordpress_db_dir=${MYLITE_WORDPRESS_DB_DIR}"
echo "wordpress_db_parent_dir=${wordpress_db_parent_dir}"
echo "wordpress_phpunit_args=$*"
echo "wordpress_nproc=$(nproc)"
df -h \
  . \
  "$(dirname "${MYLITE_WORDPRESS_DIR}")" \
  "${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}" \
  "${MYLITE_WORDPRESS_COMPOSER_CACHE_DIR}" \
  "${MYLITE_WORDPRESS_PHPUNIT_REPORT_DIR}" \
  "$(dirname "${MYLITE_WORDPRESS_MARIADB_BUILD_DIR}")" \
  "$(dirname "${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}")" \
  "${wordpress_db_parent_dir}"

if [ "${MYLITE_WORDPRESS_PHASE}" = "all" ] ||
   [ "${MYLITE_WORDPRESS_PHASE}" = "setup" ] ||
   [ "${MYLITE_WORDPRESS_PHASE}" = "fetch" ]; then
phase "Fetch WordPress develop"
fetch_start="$(date +%s)"
if [ ! -d "${MYLITE_WORDPRESS_DIR}/.git" ]; then
  git init "${MYLITE_WORDPRESS_DIR}"
  git -C "${MYLITE_WORDPRESS_DIR}" remote add origin "${MYLITE_WORDPRESS_REPO}"
fi
git -C "${MYLITE_WORDPRESS_DIR}" fetch --depth 1 origin "${MYLITE_WORDPRESS_REF}"
git -C "${MYLITE_WORDPRESS_DIR}" checkout --detach FETCH_HEAD
wordpress_sha="$(git -C "${MYLITE_WORDPRESS_DIR}" rev-parse HEAD)"
echo "wordpress_sha=${wordpress_sha}"
echo "wordpress_fetch_seconds=$(seconds_since "${fetch_start}")"
fi

if [ "${MYLITE_WORDPRESS_PHASE}" = "all" ] ||
   [ "${MYLITE_WORDPRESS_PHASE}" = "setup" ] ||
   [ "${MYLITE_WORDPRESS_PHASE}" = "build-php" ]; then
phase "Build MyLite PHP extensions"
require_requested_build_type
build_start="$(date +%s)"
mariadb_embedded_start="$(date +%s)"
BUILD_DIR="${MYLITE_WORDPRESS_MARIADB_BUILD_DIR}" tools/mariadb-embedded-build ensure
require_mariadb_embedded_production_build_type
echo "mylite_mariadb_embedded_seconds=$(seconds_since "${mariadb_embedded_start}")"
mylite_php_configure_start="$(date +%s)"
cmake -S . -B "${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}" -G Ninja \
  -DBUILD_TESTING=OFF \
  -DCMAKE_BUILD_TYPE="${MYLITE_WORDPRESS_CMAKE_BUILD_TYPE}" \
  -DMYLITE_BUILD_TOOLS=OFF \
  -DMYLITE_WARNINGS_AS_ERRORS=ON \
  -DMYLITE_WITH_MARIADB_EMBEDDED=ON \
  -DMYLITE_BUILD_PHP_EXTENSIONS=ON \
  -DMYLITE_MARIADB_BUILD_DIR="${MYLITE_WORDPRESS_MARIADB_BUILD_DIR}" \
  -DMYLITE_PHP_CONFIG_EXECUTABLE=/usr/local/bin/php-config \
  -DMYLITE_PHP_EXECUTABLE=/usr/local/bin/php
require_matching_cmake_build_type
echo "mylite_php_configure_seconds=$(seconds_since "${mylite_php_configure_start}")"
read -r -a mylite_wordpress_build_targets <<<"${MYLITE_WORDPRESS_BUILD_TARGETS}"
if [ "${#mylite_wordpress_build_targets[@]}" -eq 0 ]; then
  echo "No WordPress harness build targets configured" >&2
  exit 1
fi
echo "mylite_build_targets=${MYLITE_WORDPRESS_BUILD_TARGETS}"
mylite_php_build_start="$(date +%s)"
cmake --build "${MYLITE_WORDPRESS_CMAKE_BUILD_DIR}" --target "${mylite_wordpress_build_targets[@]}"
echo "mylite_php_build_seconds=$(seconds_since "${mylite_php_build_start}")"
mylite_php_wrapper_start="$(date +%s)"
mkdir -p "${php_ini_dir}"
cat > "${php_ini_dir}/mylite.ini" <<INI
extension=${mylite_extension}
extension=${mysqli_extension}
INI
cat > "${php_wrapper}" <<PHP
#!/usr/bin/env sh
export PHP_INI_SCAN_DIR="/usr/local/etc/php/conf.d:${php_ini_dir}"
exec /usr/local/bin/php "\$@"
PHP
chmod +x "${php_wrapper}"
"${php_wrapper}" -r 'if (!extension_loaded("mylite") || !extension_loaded("mysqli_mylite") || !function_exists("mysqli_connect")) { exit(1); }'
echo "mylite_php_wrapper_seconds=$(seconds_since "${mylite_php_wrapper_start}")"
echo "mylite_build_seconds=$(seconds_since "${build_start}")"
fi

if [ "${MYLITE_WORDPRESS_PHASE}" = "all" ] ||
   [ "${MYLITE_WORDPRESS_PHASE}" = "setup" ] ||
   [ "${MYLITE_WORDPRESS_PHASE}" = "dependencies" ]; then
phase "Install WordPress PHPUnit dependencies"
deps_start="$(date +%s)"
wordpress_composer_install_start="$(date +%s)"
composer --working-dir="${MYLITE_WORDPRESS_DIR}" install --no-interaction --no-progress --prefer-dist
echo "wordpress_composer_install_seconds=$(seconds_since "${wordpress_composer_install_start}")"
wordpress_phpunit_tool_dependency_start="$(date +%s)"
if [ ! -x "${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}/vendor/bin/phpunit" ]; then
  composer --working-dir="${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}" require --no-interaction --no-progress --prefer-dist phpunit/phpunit:^9.6
fi
echo "wordpress_phpunit_tool_dependency_seconds=$(seconds_since "${wordpress_phpunit_tool_dependency_start}")"
wordpress_phpunit_patch_start="$(date +%s)"
PHPUNIT_PROCESS_FILE="${MYLITE_WORDPRESS_PHPUNIT_TOOLS_DIR}/vendor/phpunit/phpunit/src/Util/PHP/DefaultPhpProcess.php" /usr/local/bin/php <<'PHP'
<?php
$file = getenv('PHPUNIT_PROCESS_FILE');
$source = file_get_contents($file);
$lockMarker = 'MYLITE_WORDPRESS_RELEASE_DB_LOCKS_FOR_CHILD_PROCESSES';
$timingMarker = 'MYLITE_WORDPRESS_PHPUNIT_CHILD_PROCESS_TIMINGS';
$staticCacheMarker = 'MYLITE_WORDPRESS_STATIC_WPDB_REFLECTION_CACHE';
$staticTypeFilterMarker = 'MYLITE_WORDPRESS_STATIC_WPDB_TYPE_FILTER';

$hasTimingMarker = str_contains($source, $timingMarker);
$hasStaticCacheMarker = str_contains($source, $staticCacheMarker);
$hasStaticTypeFilterMarker = str_contains($source, $staticTypeFilterMarker);
$hasChildRuntimeTiming =
    str_contains($source, "\$myliteWordPressChildStats['child_process_seconds'] +=");
$hasChildReconnectTiming =
    str_contains($source, "\$myliteWordPressChildStats['reconnect_seconds'] +=");

if ($hasTimingMarker && $hasStaticCacheMarker && $hasStaticTypeFilterMarker && $hasChildRuntimeTiming && $hasChildReconnectTiming) {
    exit(0);
}

$oldCloseWpdbs = <<<'PATCH'
        // MYLITE_WORDPRESS_RELEASE_DB_LOCKS_FOR_CHILD_PROCESSES
        $myliteWordPressClosedWpdbs = [];
        $myliteWordPressSeenWpdbs = [];
        $myliteWordPressCloseWpdb = static function ($candidate) use (&$myliteWordPressClosedWpdbs, &$myliteWordPressSeenWpdbs): void {
            if (!is_object($candidate) || !method_exists($candidate, 'close') || !method_exists($candidate, 'db_connect')) {
                return;
            }

            $objectId = spl_object_id($candidate);
            if (isset($myliteWordPressSeenWpdbs[$objectId])) {
                return;
            }

            $myliteWordPressSeenWpdbs[$objectId] = true;
            if (method_exists($candidate, 'flush')) {
                $candidate->flush();
            }
            if ($candidate->close()) {
                $myliteWordPressClosedWpdbs[] = $candidate;
            }
        };
        $myliteWordPressCloseWpdb($GLOBALS['wpdb'] ?? null);
        foreach (get_declared_classes() as $myliteWordPressClass) {
            try {
                $myliteWordPressReflection = new \ReflectionClass($myliteWordPressClass);
                foreach ($myliteWordPressReflection->getProperties(\ReflectionProperty::IS_STATIC) as $myliteWordPressProperty) {
                    $myliteWordPressProperty->setAccessible(true);
                    if (!$myliteWordPressProperty->isInitialized()) {
                        continue;
                    }
                    $myliteWordPressCloseWpdb($myliteWordPressProperty->getValue());
                }
            } catch (\Throwable $myliteWordPressIgnored) {
            }
        }

PATCH;

$oldStaticWpdbScan = <<<'PATCH'
        foreach (get_declared_classes() as $myliteWordPressClass) {
            try {
                $myliteWordPressReflection = new \ReflectionClass($myliteWordPressClass);
                foreach ($myliteWordPressReflection->getProperties(\ReflectionProperty::IS_STATIC) as $myliteWordPressProperty) {
                    $myliteWordPressProperty->setAccessible(true);
                    if (!$myliteWordPressProperty->isInitialized()) {
                        continue;
                    }
                    $myliteWordPressCloseWpdb($myliteWordPressProperty->getValue());
                }
            } catch (\Throwable $myliteWordPressIgnored) {
            }
        }

PATCH;

$cachedStaticWpdbScan = <<<'PATCH'
        // MYLITE_WORDPRESS_STATIC_WPDB_REFLECTION_CACHE
        if (!isset($GLOBALS['myliteWordPressStaticWpdbPropertyCache']) ||
            !\is_array($GLOBALS['myliteWordPressStaticWpdbPropertyCache'])) {
            $GLOBALS['myliteWordPressStaticWpdbPropertyCache'] = [
                'classes' => [],
                'properties' => [],
            ];
        }
        $myliteWordPressStaticWpdbCache =& $GLOBALS['myliteWordPressStaticWpdbPropertyCache'];
        foreach (get_declared_classes() as $myliteWordPressClass) {
            if (isset($myliteWordPressStaticWpdbCache['classes'][$myliteWordPressClass])) {
                continue;
            }
            $myliteWordPressStaticWpdbCache['classes'][$myliteWordPressClass] = true;
            try {
                $myliteWordPressReflection = new \ReflectionClass($myliteWordPressClass);
                foreach ($myliteWordPressReflection->getProperties(\ReflectionProperty::IS_STATIC) as $myliteWordPressProperty) {
                    $myliteWordPressProperty->setAccessible(true);
                    $myliteWordPressStaticWpdbCache['properties'][] = $myliteWordPressProperty;
                }
            } catch (\Throwable $myliteWordPressIgnored) {
