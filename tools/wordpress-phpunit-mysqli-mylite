if (!$db) {
    fail_perf_probe('connect failed: ' . (mysqli_connect_error() ?? ''));
}

must_query($db, 'CREATE DATABASE IF NOT EXISTS wordpress_tests');
if (!mysqli_select_db($db, 'wordpress_tests')) {
    fail_perf_probe('select database failed: ' . mysqli_error($db));
}

$start = hrtime(true);
for ($i = 0; $i < $sqlIterations; ++$i) {
    $result = mysqli_query($db, 'SELECT 1');
    if (!$result) {
        fail_perf_probe('SELECT 1 failed: ' . mysqli_error($db));
    }
    mysqli_free_result($result);
}
$select1Rate = emit_rate('wordpress_perf_select1', $sqlIterations, (hrtime(true) - $start) / 1e9);

must_query($db, 'DROP TABLE IF EXISTS mylite_perf_probe');
must_query($db, 'CREATE TABLE mylite_perf_probe (id INT PRIMARY KEY, value VARCHAR(32) NOT NULL) ENGINE=InnoDB');

$insert = mysqli_prepare($db, 'INSERT INTO mylite_perf_probe (id, value) VALUES (?, ?)');
if (!$insert) {
    fail_perf_probe('prepare insert failed: ' . mysqli_error($db));
}
$id = 0;
$value = 'mylite-perf';
if (!mysqli_stmt_bind_param($insert, 'is', $id, $value)) {
    fail_perf_probe('bind insert failed');
}

$start = hrtime(true);
must_query($db, 'START TRANSACTION');
for ($i = 1; $i <= $writeIterations; ++$i) {
    $id = $i;
    if (!mysqli_stmt_execute($insert)) {
        fail_perf_probe('execute insert failed: ' . mysqli_error($db));
    }
}
must_query($db, 'COMMIT');
$insertTxnRate = emit_rate('wordpress_perf_insert_txn', $writeIterations, (hrtime(true) - $start) / 1e9);

$start = hrtime(true);
for ($i = 0; $i < $sqlIterations; ++$i) {
    $id = ($i % $writeIterations) + 1;
    $result = mysqli_query($db, 'SELECT value FROM mylite_perf_probe WHERE id = ' . $id);
    if (!$result) {
        fail_perf_probe('execute point select failed: ' . mysqli_error($db));
    }
    if (!mysqli_fetch_assoc($result)) {
        fail_perf_probe('fetch point select failed: ' . mysqli_error($db));
    }
    mysqli_free_result($result);
}
$pointSelectRate = emit_rate('wordpress_perf_point_select', $sqlIterations, (hrtime(true) - $start) / 1e9);

must_query($db, 'DROP TABLE IF EXISTS mylite_perf_probe_autocommit');
must_query($db, 'CREATE TABLE mylite_perf_probe_autocommit (id INT PRIMARY KEY, value VARCHAR(32) NOT NULL) ENGINE=InnoDB');

$autocommitInsert = mysqli_prepare($db, 'INSERT INTO mylite_perf_probe_autocommit (id, value) VALUES (?, ?)');
if (!$autocommitInsert) {
    fail_perf_probe('prepare autocommit insert failed: ' . mysqli_error($db));
}
$id = 0;
$value = 'mylite-perf';
if (!mysqli_stmt_bind_param($autocommitInsert, 'is', $id, $value)) {
    fail_perf_probe('bind autocommit insert failed');
}

$start = hrtime(true);
for ($i = 1; $i <= $writeIterations; ++$i) {
    $id = $i;
    if (!mysqli_stmt_execute($autocommitInsert)) {
        fail_perf_probe('execute autocommit insert failed: ' . mysqli_error($db));
    }
}
$insertAutocommitRate = emit_rate(
    'wordpress_perf_insert_autocommit',
    $writeIterations,
    (hrtime(true) - $start) / 1e9
);

must_query($db, 'DROP TABLE IF EXISTS mylite_perf_probe_direct_autocommit');
must_query($db, 'CREATE TABLE mylite_perf_probe_direct_autocommit (id INT PRIMARY KEY, value VARCHAR(32) NOT NULL) ENGINE=InnoDB');

$start = hrtime(true);
for ($i = 1; $i <= $writeIterations; ++$i) {
    if (!mysqli_query($db, "INSERT INTO mylite_perf_probe_direct_autocommit (id, value) VALUES ($i, 'mylite-perf')")) {
        fail_perf_probe('execute direct autocommit insert failed: ' . mysqli_error($db));
    }
}
$insertDirectAutocommitRate = emit_rate(
    'wordpress_perf_insert_direct_autocommit',
    $writeIterations,
    (hrtime(true) - $start) / 1e9
);

printf("wordpress_perf_summary_mysqli_inprocess_connect_close_ms_avg=%.3f\n", $inprocessConnectMs);
printf("wordpress_perf_summary_mysqli_active_runtime_reconnect_ms_avg=%.3f\n", $activeRuntimeReconnectMs);
printf("wordpress_perf_summary_select1_ops_per_second=%.2f\n", $select1Rate);
printf("wordpress_perf_summary_insert_txn_ops_per_second=%.2f\n", $insertTxnRate);
printf("wordpress_perf_summary_point_select_ops_per_second=%.2f\n", $pointSelectRate);
printf("wordpress_perf_summary_insert_autocommit_ops_per_second=%.2f\n", $insertAutocommitRate);
printf(
    "wordpress_perf_summary_insert_direct_autocommit_ops_per_second=%.2f\n",
    $insertDirectAutocommitRate
);
printf(
    "wordpress_perf_summary_insert_direct_vs_prepared_autocommit_ratio=%.4f\n",
    $insertAutocommitRate > 0.000001 ? $insertDirectAutocommitRate / $insertAutocommitRate : 0.0
);

must_query($db, 'DROP TABLE IF EXISTS mylite_perf_probe');
must_query($db, 'DROP TABLE IF EXISTS mylite_perf_probe_autocommit');
must_query($db, 'DROP TABLE IF EXISTS mylite_perf_probe_direct_autocommit');
mysqli_close($db);
