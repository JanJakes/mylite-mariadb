#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workflow="${root_dir}/.github/workflows/ci.yml"
wordpress_harness="${root_dir}/tools/wordpress-phpunit-mysqli-mylite"
wordpress_timing_append="${root_dir}/tools/wordpress-phpunit-append-timing"
wordpress_timing_rollup="${root_dir}/tools/wordpress-phpunit-timing-rollup"
failed=0

require_literal() {
  local needle="$1"

  if ! grep -Fq -- "${needle}" "${workflow}"; then
    echo "Missing required CI production-build marker: ${needle}" >&2
    failed=1
  fi
}

require_file_literal() {
  local file="$1"
  local needle="$2"

  if ! grep -Fq -- "${needle}" "${file}"; then
    echo "Missing required production-build marker in ${file}: ${needle}" >&2
    failed=1
  fi
}

require_literal_count_at_least() {
  local needle="$1"
  local minimum="$2"
  local count

  count="$(grep -Fc -- "${needle}" "${workflow}" || true)"
  if [ "${count}" -lt "${minimum}" ]; then
    echo \
      "Missing required CI production-build marker count: ${needle} (${count}/${minimum})" \
      >&2
    failed=1
  fi
}

require_step_literal() {
  local step_name="$1"
  local needle="$2"
  local status

  if awk -v step_name="${step_name}" -v needle="${needle}" '
    /^[[:space:]]+- name: / {
      in_step = ($0 == "      - name: " step_name)
      if (in_step) {
        seen = 1
      }
      next
    }
    in_step && index($0, needle) > 0 {
      found = 1
    }
    END {
      if (!seen) {
        exit 2
      }
      if (!found) {
        exit 1
      }
    }
  ' "${workflow}"; then
    status=0
  else
    status="$?"
  fi

  case "${status}" in
    0)
      ;;
    1)
      echo "Missing required CI production-build marker inside step '${step_name}': ${needle}" >&2
      failed=1
      ;;
    2)
      echo "Missing required CI production-build step: ${step_name}" >&2
      failed=1
      ;;
    *)
      echo "Could not audit CI production-build step '${step_name}'" >&2
      failed=1
      ;;
  esac
}

forbid_step_literal() {
  local step_name="$1"
  local needle="$2"
  local status

  if awk -v step_name="${step_name}" -v needle="${needle}" '
    /^[[:space:]]+- name: / {
      in_step = ($0 == "      - name: " step_name)
      if (in_step) {
        seen = 1
      }
      next
    }
    in_step && index($0, needle) > 0 {
      found = 1
    }
    END {
      if (!seen) {
        exit 2
      }
      if (found) {
        exit 1
      }
    }
  ' "${workflow}"; then
    status=0
  else
    status="$?"
  fi

  case "${status}" in
    0)
      ;;
    1)
      echo "Forbidden CI production timing marker inside step '${step_name}': ${needle}" >&2
      failed=1
      ;;
    2)
      echo "Missing required CI production-build step: ${step_name}" >&2
      failed=1
      ;;
    *)
      echo "Could not audit CI production-build step '${step_name}'" >&2
      failed=1
      ;;
  esac
}

require_step_order() {
  local first_step="$1"
  local second_step="$2"
  local first_line
  local second_line

  first_line="$(
    grep -nF -- "      - name: ${first_step}" "${workflow}" | head -n 1 | cut -d: -f1 || true
  )"
  second_line="$(
    grep -nF -- "      - name: ${second_step}" "${workflow}" | head -n 1 | cut -d: -f1 || true
  )"

  if [ -z "${first_line}" ] || [ -z "${second_line}" ]; then
    echo \
      "Could not audit CI step order: '${first_step}' before '${second_step}'" \
      >&2
    failed=1
    return
  fi

  if [ "${first_line}" -ge "${second_line}" ]; then
    echo \
      "CI step order must keep '${first_step}' before '${second_step}'" \
      >&2
    failed=1
  fi
}

require_step_timeout() {
  local step_name="$1"
  local minutes="$2"
  local status

  if awk -v step_name="${step_name}" -v minutes="${minutes}" '
    BEGIN {
      timeout = "        timeout-minutes: " minutes
    }
    /^[[:space:]]+- name: / {
      in_step = ($0 == "      - name: " step_name)
      if (in_step) {
        seen = 1
      }
      next
    }
    in_step && $0 == timeout {
      found = 1
    }
    END {
      if (!seen) {
        exit 2
      }
      if (!found) {
        exit 1
      }
    }
  ' "${workflow}"; then
    status=0
  else
    status="$?"
  fi

  case "${status}" in
    0)
      ;;
    1)
      echo "Missing required CI timeout inside step '${step_name}': ${minutes} minutes" >&2
      failed=1
      ;;
    2)
      echo "Missing required CI timeout step: ${step_name}" >&2
      failed=1
      ;;
    *)
      echo "Could not audit CI timeout for step '${step_name}'" >&2
      failed=1
      ;;
  esac
}

require_embedded_timing_step_guards() {
