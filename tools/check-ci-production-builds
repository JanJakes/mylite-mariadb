#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workflow="${root_dir}/.github/workflows/ci.yml"
failed=0

require_literal() {
  local needle="$1"

  if ! grep -Fq -- "${needle}" "${workflow}"; then
    echo "Missing required CI production-build marker: ${needle}" >&2
    failed=1
  fi
}

require_literal_count_at_least() {
  local needle="$1"
  local minimum="$2"
  local count

  count="$(grep -Fc -- "${needle}" "${workflow}" || true)"
  if [ "${count}" -lt "${minimum}" ]; then
    echo \
      "Missing required CI production-build marker count: ${needle} (${count}/${minimum})" \
      >&2
    failed=1
  fi
}

reject_regex() {
  local pattern="$1"
  local description="$2"
  local matches

  matches="$(LC_ALL=C grep -En -- "${pattern}" "${workflow}" || true)"
  if [ -n "${matches}" ]; then
    echo "Forbidden CI production-build pattern found: ${description}" >&2
    echo "${matches}" >&2
    failed=1
  fi
}

if [ ! -f "${workflow}" ]; then
  echo "Missing CI workflow: ${workflow}" >&2
  exit 1
fi

reject_regex \
  '(^|[[:space:]])(cmake|ctest)[^#[:cntrl:]]*--preset[[:space:]]+(dev|embedded-dev|php-embedded-dev)([^[:alnum:]_-]|$)' \
  "CMake-backed CI must not use developer presets"
reject_regex \
  'build/(dev|embedded-dev|php-embedded-dev|wordpress-php-embedded)([^[:alnum:]_-]|$)' \
  "CMake-backed CI must not use developer build directories"
reject_regex \
  'MYLITE_WORDPRESS_PHASE:[[:space:]]*all' \
  "WordPress CI timing must not use the all-in-one harness phase"
reject_regex \
  'Run WordPress PHPUnit suite' \
  "WordPress PHPUnit CI must keep test-only suite steps separated from setup/build work"
reject_regex \
  'MYLITE_WORDPRESS_PHPUNIT_ISOLATED_FILTER' \
  "WordPress PHPUnit CI must not keep the stale broad isolated-class filter"

require_literal "cmake --preset prod"
require_literal "cmake --build --preset prod"
require_literal "ctest --preset prod"
require_literal "cmake --preset php-embedded-prod"
require_literal "cmake --build --preset php-embedded-prod"
require_literal "ctest --preset php-embedded-prod"
require_literal "cmake --build --preset format-check-prod"
require_literal "cmake --build --preset tidy-prod"

require_literal "tools/require-cmake-release-build build/prod"
require_literal "tools/require-cmake-release-build build/php-embedded-prod"
require_literal "tools/require-cmake-release-build build/wordpress-php-embedded-prod"
require_literal "tools/require-cmake-build-type MinSizeRel build/mariadb-embedded"
require_literal "tools/require-cmake-build-type MinSizeRel build/wordpress-mariadb-embedded"

require_literal "MYLITE_WORDPRESS_CMAKE_BUILD_DIR: build/wordpress-php-embedded-prod"
require_literal "MYLITE_WORDPRESS_CMAKE_BUILD_TYPE: Release"
require_literal 'MYLITE_WORDPRESS_REQUIRE_RELEASE_BUILD: "1"'
require_literal 'MYLITE_WORDPRESS_REQUIRE_EXTERNAL_DB_DIR: "1"'
require_literal 'MYLITE_WORDPRESS_PHPUNIT_LOG_JUNIT: "1"'
require_literal 'MYLITE_WORDPRESS_PHPUNIT_PROFILE_CHILD_PROCESSES: "0"'
require_literal 'MYLITE_WORDPRESS_PHPUNIT_STATIC_WPDB_SCAN: "0"'
require_literal "MYLITE_WORDPRESS_PHPUNIT_DEFERRED_RECONNECT_FILTER:"
require_literal "MYLITE_WORDPRESS_PHPUNIT_EAGER_RECONNECT_FILTER:"
require_literal "MYLITE_WORDPRESS_PHPUNIT_NON_ISOLATED_FILTER:"
require_literal "Tests_Admin_ExportWp|Tests_oEmbed_HTTP_Headers"
require_literal "Tests_Filesystem_WpFilesystemDirect_Chmod::test_should_handle_set_mode_when_not_passed"
require_literal "Tests_Admin_WpUpgrader::test_maintenance_mode_should_create_maintenance_file_with_boolean"
require_literal "Tests_Formatting_Emoji::test_print_emoji_detection_script_on_front_end_after_footer_scripts_printed"
require_literal "Tests_Theme::test_default_themes_are_included_in_new_files"
require_literal "Build WordPress PHPUnit Docker image"
require_literal "Fetch WordPress PHPUnit sources"
require_literal "Build MyLite PHP extensions for WordPress PHPUnit"
require_literal "Install WordPress PHPUnit dependencies"
require_literal "Prepare WordPress PHPUnit database"
require_literal "Run WordPress mysqli performance probe"
require_literal "Run WordPress PHPUnit database suite (test only)"
require_literal "Run WordPress PHPUnit process-isolated deferred-reconnect suite (test only)"
require_literal "Run WordPress PHPUnit process-isolated eager-reconnect suite (test only)"
require_literal "Run WordPress PHPUnit non-isolated remaining suite (test only)"
require_literal "MYLITE_WORDPRESS_PHASE: docker-image"
require_literal "MYLITE_WORDPRESS_PHASE: fetch"
require_literal "MYLITE_WORDPRESS_PHASE: build-php"
require_literal "MYLITE_WORDPRESS_PHASE: dependencies"
require_literal "MYLITE_WORDPRESS_PHASE: prepare-db"
require_literal "MYLITE_WORDPRESS_PHASE: perf-probe"
require_literal_count_at_least "MYLITE_WORDPRESS_PHASE: phpunit" 4
require_literal_count_at_least 'MYLITE_WORDPRESS_SKIP_DOCKER_BUILD: "1"' 8

require_literal "ownerless_sql_test=build/php-embedded-prod/packages/libmylite/mylite_ownerless_cross_process_sql_test"
require_literal "build/php-embedded-prod/packages/libmylite/mylite_embedded_performance_probe"

if [ "${failed}" -ne 0 ]; then
  exit 1
fi

echo "ci_production_build_audit_ok=${workflow}"
