#!/usr/bin/env bash
set -euo pipefail

rounds=24
rows=12
reader_polls=48
output_dir=""
check=0

usage() {
  cat <<EOF
Usage: tools/ownerless-active-reader-pressure-trace --output DIR [--rounds N] [--rows N] [--reader-polls N] [--check]

Generate deterministic SQL traces for active-reader pressure. The trace holds a
repeatable-read consistent snapshot while a worker updates large InnoDB rows.
Worker and reader files are intended to be run concurrently by an external
MariaDB/RQG-style harness; expected.sql contains the durable final oracle.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --output)
      output_dir="${2:-}"
      shift 2
      ;;
    --rounds)
      rounds="${2:-}"
      shift 2
      ;;
    --rows)
      rows="${2:-}"
      shift 2
      ;;
    --reader-polls)
      reader_polls="${2:-}"
      shift 2
      ;;
    --check)
      check=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "${output_dir}" ]; then
  echo "--output is required" >&2
  usage >&2
  exit 2
fi

case "${rounds}" in
  ''|*[!0-9]*)
    echo "--rounds must be a positive integer" >&2
    exit 2
    ;;
esac
if [ "${rounds}" -le 0 ] || [ "${rounds}" -gt 10000 ]; then
  echo "--rounds must be between 1 and 10000" >&2
  exit 2
fi

case "${rows}" in
  ''|*[!0-9]*)
    echo "--rows must be a positive integer" >&2
    exit 2
    ;;
esac
if [ "${rows}" -le 0 ] || [ "${rows}" -gt 1000 ]; then
  echo "--rows must be between 1 and 1000" >&2
  exit 2
fi

case "${reader_polls}" in
  ''|*[!0-9]*)
    echo "--reader-polls must be a positive integer" >&2
    exit 2
    ;;
esac
if [ "${reader_polls}" -le 0 ] || [ "${reader_polls}" -gt 20000 ]; then
  echo "--reader-polls must be between 1 and 20000" >&2
  exit 2
fi

initial_sum=$((rows * (rows + 1) * 5))
expected_delta=$((rounds * (rounds + 1) / 2))
expected_sum=$((initial_sum + expected_delta))
expected_versions="${rounds}"
expected_payload_bytes=$((rows * 4000))
replace_like_expected_sum=230
replace_ctas_expected_sum=430
auto_inc_expected_count=4
auto_inc_expected_id_sum=106
auto_inc_expected_max_id=100
auto_inc_expected_value_sum=1060
retry_limit=40

mkdir -p "${output_dir}"

schema_sql="${output_dir}/schema.sql"
reader_sql="${output_dir}/reader.sql"
worker_sql="${output_dir}/worker-1.sql"
expected_sql="${output_dir}/expected.sql"
manifest="${output_dir}/manifest.txt"

{
  echo "CREATE DATABASE IF NOT EXISTS app;"
  echo "USE app;"
  echo "DROP TABLE IF EXISTS ownerless_active_reader_trace;"
  echo "DROP TABLE IF EXISTS ownerless_active_reader_replace_like;"
  echo "DROP TABLE IF EXISTS ownerless_active_reader_replace_like_source;"
  echo "DROP TABLE IF EXISTS ownerless_active_reader_replace_ctas;"
  echo "DROP TABLE IF EXISTS ownerless_active_reader_replace_ctas_source;"
  echo "DROP TABLE IF EXISTS ownerless_active_reader_auto_inc;"
  echo "CREATE TABLE ownerless_active_reader_trace ("
  echo "  id INT NOT NULL PRIMARY KEY,"
  echo "  value INT NOT NULL,"
  echo "  version INT NOT NULL,"
  echo "  payload VARBINARY(4000) NOT NULL,"
  echo "  INDEX ownerless_active_reader_trace_value_idx (value)"
  echo ") ENGINE=InnoDB;"
  for row_id in $(seq 1 "${rows}"); do
    echo "INSERT INTO ownerless_active_reader_trace VALUES (${row_id}, $((row_id * 10)), 0, REPEAT('a', 4000));"
  done
  echo "CREATE TABLE ownerless_active_reader_replace_like_source ("
  echo "  id INT NOT NULL PRIMARY KEY,"
  echo "  value INT NOT NULL,"
  echo "  note VARCHAR(16) NOT NULL,"
  echo "  INDEX ownerless_active_reader_replace_like_value_idx (value)"
  echo ") ENGINE=InnoDB;"
  echo "INSERT INTO ownerless_active_reader_replace_like_source VALUES"
  echo "  (1, 10, 'alpha'),"
  echo "  (2, 20, 'beta');"
  echo "CREATE TABLE ownerless_active_reader_replace_like ("
  echo "  id INT NOT NULL PRIMARY KEY,"
  echo "  old_value INT NOT NULL,"
  echo "  stale_note VARCHAR(16) NOT NULL,"
  echo "  INDEX ownerless_active_reader_replace_like_old_idx (old_value)"
  echo ") ENGINE=InnoDB;"
  echo "INSERT INTO ownerless_active_reader_replace_like VALUES (1, 9, 'old');"
  echo "CREATE TABLE ownerless_active_reader_replace_ctas_source ("
  echo "  id INT NOT NULL PRIMARY KEY,"
  echo "  value INT NOT NULL,"
  echo "  note VARCHAR(16) NOT NULL"
  echo ") ENGINE=InnoDB;"
  echo "INSERT INTO ownerless_active_reader_replace_ctas_source VALUES"
  echo "  (1, 10, 'alpha'),"
  echo "  (2, 20, 'beta');"
  echo "CREATE TABLE ownerless_active_reader_replace_ctas ("
  echo "  id INT NOT NULL PRIMARY KEY,"
  echo "  old_value INT NOT NULL,"
  echo "  stale_note VARCHAR(16) NOT NULL,"
  echo "  INDEX ownerless_active_reader_replace_ctas_old_idx (old_value)"
  echo ") ENGINE=InnoDB;"
  echo "INSERT INTO ownerless_active_reader_replace_ctas VALUES (1, 9, 'old');"
  echo "CREATE TABLE ownerless_active_reader_auto_inc ("
  echo "  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,"
  echo "  value INT NOT NULL"
  echo ") ENGINE=InnoDB;"
  echo "INSERT INTO ownerless_active_reader_auto_inc (value) VALUES (10), (20);"
  echo "DELIMITER //"
  echo "DROP PROCEDURE IF EXISTS ownerless_active_reader_trace_worker//"
  echo "CREATE PROCEDURE ownerless_active_reader_trace_worker()"
  echo "BEGIN"
  echo "  DECLARE ownerless_active_reader_retry BOOL DEFAULT FALSE;"
  echo "  DECLARE ownerless_active_reader_attempts INT DEFAULT 0;"
  echo "  DECLARE ownerless_active_reader_retries INT DEFAULT 0;"
  for round in $(seq 1 "${rounds}"); do
    row_id=$((((round - 1) % rows) + 1))
    case $((round % 4)) in
      0)
        payload_char="b"
        ;;
      1)
        payload_char="c"
        ;;
      2)
        payload_char="d"
        ;;
      *)
        payload_char="e"
        ;;
    esac
    echo "  SET ownerless_active_reader_attempts = 0;"
    echo "  ownerless_active_reader_round_${round}: LOOP"
    echo "    SET ownerless_active_reader_retry = FALSE;"
    echo "    SET ownerless_active_reader_attempts = ownerless_active_reader_attempts + 1;"
    echo "    BEGIN"
    echo "      DECLARE EXIT HANDLER FOR 1205, 1213, SQLSTATE '40001'"
    echo "      BEGIN"
    echo "        SET ownerless_active_reader_retry = TRUE;"
    echo "        SET ownerless_active_reader_retries = ownerless_active_reader_retries + 1;"
    echo "        ROLLBACK;"
    echo "      END;"
    echo "      START TRANSACTION;"
    echo "      UPDATE ownerless_active_reader_trace"
    echo "      SET value = value + ${round},"
    echo "          version = version + 1,"
    echo "          payload = REPEAT('${payload_char}', 4000)"
    echo "      WHERE id = ${row_id};"
    echo "      COMMIT;"
    echo "    END;"
    echo "    IF ownerless_active_reader_retry = FALSE THEN"
    echo "      LEAVE ownerless_active_reader_round_${round};"
    echo "    END IF;"
    echo "    IF ownerless_active_reader_attempts >= ${retry_limit} THEN"
    echo "      SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'ownerless active-reader retry limit reached';"
    echo "    END IF;"
    echo "    DO SLEEP(0.02);"
    echo "  END LOOP;"
    if [ $((round % 6)) -eq 0 ] || [ "${round}" -eq "${rounds}" ]; then
      echo "  SELECT CASE"
      echo "    WHEN (SELECT SUM(version) FROM ownerless_active_reader_trace) = ${round}"
      echo "    THEN 'ok'"
      echo "    ELSE 'mismatch'"
      echo "  END AS ownerless_active_reader_trace_worker_check;"
    fi
    echo
  done
  echo "  CREATE OR REPLACE TABLE ownerless_active_reader_replace_like"
  echo "    LIKE ownerless_active_reader_replace_like_source;"
  echo "  INSERT INTO ownerless_active_reader_replace_like"
  echo "    SELECT id, value + 100, note"
  echo "    FROM ownerless_active_reader_replace_like_source;"
  echo "  CREATE OR REPLACE TABLE ownerless_active_reader_replace_ctas ENGINE=InnoDB AS"
  echo "    SELECT id, value + 200 AS value, note AS copied_note"
  echo "    FROM ownerless_active_reader_replace_ctas_source;"
  echo "  INSERT INTO ownerless_active_reader_auto_inc (value) VALUES (30);"
  echo "  ALTER TABLE ownerless_active_reader_auto_inc AUTO_INCREMENT = 100;"
  echo "  INSERT INTO ownerless_active_reader_auto_inc (value) VALUES (1000);"
  echo "  SELECT CASE"
  echo "    WHEN (SELECT SUM(value) FROM ownerless_active_reader_replace_like) = ${replace_like_expected_sum}"
  echo "     AND (SELECT SUM(value) FROM ownerless_active_reader_replace_ctas) = ${replace_ctas_expected_sum}"
  echo "    THEN 'ok'"
  echo "    ELSE 'mismatch'"
  echo "  END AS ownerless_active_reader_trace_replacement_check;"
  echo "  SELECT CASE"
  echo "    WHEN (SELECT COUNT(*) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_count}"
  echo "     AND (SELECT SUM(id) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_id_sum}"
  echo "     AND (SELECT MAX(id) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_max_id}"
  echo "     AND (SELECT SUM(value) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_value_sum}"
  echo "    THEN 'ok'"
  echo "    ELSE 'mismatch'"
  echo "  END AS ownerless_active_reader_trace_auto_inc_check;"
  echo "  SELECT ownerless_active_reader_retries AS ownerless_active_reader_trace_retries;"
  echo "END//"
  echo "DROP PROCEDURE IF EXISTS ownerless_active_reader_trace_reader//"
  echo "CREATE PROCEDURE ownerless_active_reader_trace_reader()"
  echo "BEGIN"
  echo "  DECLARE ownerless_active_reader_retry BOOL DEFAULT FALSE;"
  echo "  DECLARE ownerless_active_reader_attempts INT DEFAULT 0;"
  echo "  DECLARE ownerless_active_reader_retries INT DEFAULT 0;"
  echo "  ownerless_active_reader_trace_reader: LOOP"
  echo "    SET ownerless_active_reader_retry = FALSE;"
  echo "    SET ownerless_active_reader_attempts = ownerless_active_reader_attempts + 1;"
  echo "    BEGIN"
  echo "      DECLARE EXIT HANDLER FOR 1020, 1205, 1213, SQLSTATE '40001'"
  echo "      BEGIN"
  echo "        SET ownerless_active_reader_retry = TRUE;"
  echo "        SET ownerless_active_reader_retries = ownerless_active_reader_retries + 1;"
  echo "        ROLLBACK;"
  echo "      END;"
  echo "      SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;"
  echo "      START TRANSACTION WITH CONSISTENT SNAPSHOT;"
  echo "      SET @ownerless_active_reader_trace_count := (SELECT COUNT(*) FROM ownerless_active_reader_trace);"
  echo "      SET @ownerless_active_reader_trace_sum := (SELECT SUM(value) FROM ownerless_active_reader_trace);"
  echo "      SET @ownerless_active_reader_trace_versions := (SELECT SUM(version) FROM ownerless_active_reader_trace);"
  echo "      SET @ownerless_active_reader_trace_payload := (SELECT SUM(LENGTH(payload)) FROM ownerless_active_reader_trace);"
  for _poll in $(seq 1 "${reader_polls}"); do
    echo "      SELECT CASE"
    echo "        WHEN (SELECT COUNT(*) FROM ownerless_active_reader_trace) = ${rows}"
    echo "         AND (SELECT COUNT(*) FROM ownerless_active_reader_trace) = @ownerless_active_reader_trace_count"
    echo "         AND (SELECT SUM(value) FROM ownerless_active_reader_trace) = @ownerless_active_reader_trace_sum"
    echo "         AND (SELECT SUM(version) FROM ownerless_active_reader_trace) = @ownerless_active_reader_trace_versions"
    echo "         AND (SELECT SUM(LENGTH(payload)) FROM ownerless_active_reader_trace) = @ownerless_active_reader_trace_payload"
    echo "        THEN 'ok'"
    echo "        ELSE 'mismatch'"
    echo "      END AS ownerless_active_reader_trace_snapshot_check;"
  done
  echo "      COMMIT;"
  echo "      SELECT CASE"
  echo "        WHEN (SELECT SUM(version) FROM ownerless_active_reader_trace) >= @ownerless_active_reader_trace_versions"
  echo "         AND (SELECT SUM(version) FROM ownerless_active_reader_trace) <= ${expected_versions}"
  echo "        THEN 'ok'"
  echo "        ELSE 'mismatch'"
  echo "      END AS ownerless_active_reader_trace_after_commit_check;"
  echo "    END;"
  echo "    IF ownerless_active_reader_retry = FALSE THEN"
  echo "      LEAVE ownerless_active_reader_trace_reader;"
  echo "    END IF;"
  echo "    IF ownerless_active_reader_attempts >= ${retry_limit} THEN"
  echo "      SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'ownerless active-reader reader retry limit reached';"
  echo "    END IF;"
  echo "    DO SLEEP(0.02);"
  echo "  END LOOP;"
  echo "  SELECT ownerless_active_reader_retries AS ownerless_active_reader_trace_reader_retries;"
  echo "END//"
  echo "DELIMITER ;"
} >"${schema_sql}"

{
  echo "USE app;"
  echo "SET SESSION innodb_lock_wait_timeout = 30;"
  echo "SET SESSION lock_wait_timeout = 30;"
  echo "-- active-reader pressure worker"
  echo "CALL ownerless_active_reader_trace_worker();"
} >"${worker_sql}"

{
  echo "USE app;"
  echo "SET SESSION innodb_lock_wait_timeout = 30;"
  echo "SET SESSION lock_wait_timeout = 30;"
  echo "-- active-reader pressure snapshot reader"
  echo "CALL ownerless_active_reader_trace_reader();"
} >"${reader_sql}"

{
  echo "USE app;"
  echo "-- expected_rows=${rows}"
  echo "-- expected_sum=${expected_sum}"
  echo "-- expected_versions=${expected_versions}"
  echo "-- expected_payload_bytes=${expected_payload_bytes}"
  echo "SELECT"
  echo "  COUNT(*) AS observed_rows,"
  echo "  SUM(value) AS observed_sum,"
  echo "  SUM(version) AS observed_versions,"
  echo "  SUM(LENGTH(payload)) AS observed_payload_bytes"
  echo "FROM ownerless_active_reader_trace;"
  echo "SELECT"
  echo "  COUNT(*) AS observed_replace_like_rows,"
  echo "  SUM(value) AS observed_replace_like_sum"
  echo "FROM ownerless_active_reader_replace_like;"
  echo "SELECT"
  echo "  COUNT(*) AS observed_replace_ctas_rows,"
  echo "  SUM(value) AS observed_replace_ctas_sum"
  echo "FROM ownerless_active_reader_replace_ctas;"
  echo "SELECT"
  echo "  COUNT(*) AS observed_auto_inc_rows,"
  echo "  SUM(id) AS observed_auto_inc_id_sum,"
  echo "  MAX(id) AS observed_auto_inc_max_id,"
  echo "  SUM(value) AS observed_auto_inc_value_sum"
  echo "FROM ownerless_active_reader_auto_inc;"
  echo "SELECT CASE"
  echo "  WHEN COUNT(*) = ${rows}"
  echo "   AND SUM(value) = ${expected_sum}"
  echo "   AND SUM(version) = ${expected_versions}"
  echo "   AND SUM(LENGTH(payload)) = ${expected_payload_bytes}"
  echo "  THEN 'ok'"
  echo "  ELSE 'mismatch'"
  echo "END AS ownerless_active_reader_trace_check"
  echo "FROM ownerless_active_reader_trace;"
  echo "SELECT CASE"
  echo "  WHEN (SELECT COUNT(*) FROM ownerless_active_reader_replace_like) = 2"
  echo "   AND (SELECT SUM(value) FROM ownerless_active_reader_replace_like) = ${replace_like_expected_sum}"
  echo "   AND (SELECT SUM(id) FROM ownerless_active_reader_replace_like"
  echo "        FORCE INDEX (ownerless_active_reader_replace_like_value_idx)"
  echo "        WHERE value >= 120) = 2"
  echo "   AND (SELECT COUNT(*) FROM information_schema.statistics"
  echo "        WHERE table_schema = 'app'"
  echo "          AND table_name = 'ownerless_active_reader_replace_like'"
  echo "          AND index_name = 'ownerless_active_reader_replace_like_old_idx') = 0"
  echo "  THEN 'ok'"
  echo "  ELSE 'mismatch'"
  echo "END AS ownerless_active_reader_replace_like_check;"
  echo "SELECT CASE"
  echo "  WHEN (SELECT COUNT(*) FROM ownerless_active_reader_replace_ctas) = 2"
  echo "   AND (SELECT SUM(value) FROM ownerless_active_reader_replace_ctas) = ${replace_ctas_expected_sum}"
  echo "   AND (SELECT COUNT(*) FROM information_schema.columns"
  echo "        WHERE table_schema = 'app'"
  echo "          AND table_name = 'ownerless_active_reader_replace_ctas'"
  echo "          AND column_name = 'copied_note') = 1"
  echo "   AND (SELECT COUNT(*) FROM information_schema.columns"
  echo "        WHERE table_schema = 'app'"
  echo "          AND table_name = 'ownerless_active_reader_replace_ctas'"
  echo "          AND column_name = 'old_value') = 0"
  echo "  THEN 'ok'"
  echo "  ELSE 'mismatch'"
  echo "END AS ownerless_active_reader_replace_ctas_check;"
  echo "SELECT CASE"
  echo "  WHEN (SELECT COUNT(*) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_count}"
  echo "   AND (SELECT SUM(id) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_id_sum}"
  echo "   AND (SELECT MAX(id) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_max_id}"
  echo "   AND (SELECT SUM(value) FROM ownerless_active_reader_auto_inc) = ${auto_inc_expected_value_sum}"
  echo "  THEN 'ok'"
  echo "  ELSE 'mismatch'"
  echo "END AS ownerless_active_reader_auto_inc_check;"
} >"${expected_sql}"

{
  echo "workers=1"
  echo "rounds=${rounds}"
  echo "rows=${rows}"
  echo "reader_polls=${reader_polls}"
  echo "initial_sum=${initial_sum}"
  echo "expected_delta=${expected_delta}"
  echo "expected_sum=${expected_sum}"
  echo "expected_versions=${expected_versions}"
  echo "expected_payload_bytes=${expected_payload_bytes}"
  echo "replace_like_expected_sum=${replace_like_expected_sum}"
  echo "replace_ctas_expected_sum=${replace_ctas_expected_sum}"
  echo "auto_inc_expected_count=${auto_inc_expected_count}"
  echo "auto_inc_expected_id_sum=${auto_inc_expected_id_sum}"
  echo "auto_inc_expected_max_id=${auto_inc_expected_max_id}"
  echo "auto_inc_expected_value_sum=${auto_inc_expected_value_sum}"
  echo "retry_limit=${retry_limit}"
} >"${manifest}"

if [ "${check}" -eq 1 ]; then
  test -s "${schema_sql}"
  test -s "${reader_sql}"
  test -s "${worker_sql}"
  test -s "${expected_sql}"
  test -s "${manifest}"
  grep -q "START TRANSACTION WITH CONSISTENT SNAPSHOT" "${schema_sql}"
  grep -q "DECLARE EXIT HANDLER FOR 1205, 1213, SQLSTATE '40001'" "${schema_sql}"
  grep -q "DECLARE EXIT HANDLER FOR 1020, 1205, 1213, SQLSTATE '40001'" "${schema_sql}"
  grep -q "CALL ownerless_active_reader_trace_worker" "${worker_sql}"
  grep -q "CALL ownerless_active_reader_trace_reader" "${reader_sql}"
  grep -q "ownerless_active_reader_trace_snapshot_check" "${schema_sql}"
  grep -q "ownerless_active_reader_trace_worker_check" "${schema_sql}"
  grep -q "CREATE OR REPLACE TABLE ownerless_active_reader_replace_like" "${schema_sql}"
  grep -q "CREATE OR REPLACE TABLE ownerless_active_reader_replace_ctas" "${schema_sql}"
  grep -q "CREATE TABLE ownerless_active_reader_auto_inc" "${schema_sql}"
  grep -q "ALTER TABLE ownerless_active_reader_auto_inc AUTO_INCREMENT = 100" "${schema_sql}"
  grep -q "ownerless_active_reader_trace_replacement_check" "${schema_sql}"
  grep -q "ownerless_active_reader_trace_auto_inc_check" "${schema_sql}"
  grep -q "ownerless_active_reader_trace_reader_retries" "${schema_sql}"
  grep -q "ownerless_active_reader_trace_check" "${expected_sql}"
  grep -q "ownerless_active_reader_replace_like_check" "${expected_sql}"
  grep -q "ownerless_active_reader_replace_ctas_check" "${expected_sql}"
  grep -q "ownerless_active_reader_auto_inc_check" "${expected_sql}"
  grep -q "expected_sum=${expected_sum}" "${manifest}"
  grep -q "expected_versions=${expected_versions}" "${manifest}"
  grep -q "expected_payload_bytes=${expected_payload_bytes}" "${manifest}"
  grep -q "replace_like_expected_sum=${replace_like_expected_sum}" "${manifest}"
  grep -q "replace_ctas_expected_sum=${replace_ctas_expected_sum}" "${manifest}"
  grep -q "auto_inc_expected_count=${auto_inc_expected_count}" "${manifest}"
  grep -q "auto_inc_expected_id_sum=${auto_inc_expected_id_sum}" "${manifest}"
  grep -q "auto_inc_expected_max_id=${auto_inc_expected_max_id}" "${manifest}"
  grep -q "auto_inc_expected_value_sum=${auto_inc_expected_value_sum}" "${manifest}"
  grep -q "retry_limit=${retry_limit}" "${manifest}"
fi

echo "trace_dir=${output_dir}"
echo "rounds=${rounds}"
echo "rows=${rows}"
echo "reader_polls=${reader_polls}"
echo "expected_sum=${expected_sum}"
echo "expected_versions=${expected_versions}"
echo "auto_inc_expected_id_sum=${auto_inc_expected_id_sum}"
echo "auto_inc_expected_max_id=${auto_inc_expected_max_id}"
