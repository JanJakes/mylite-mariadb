#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "Usage: tools/require-cmake-build-type <expected-build-type> <cmake-build-dir>..." >&2
  exit 2
fi

expected_build_type="$1"
shift

if [ -z "${expected_build_type}" ]; then
  echo "Expected CMake build type must not be empty." >&2
  exit 2
fi

for build_dir in "$@"; do
  cache="${build_dir%/}/CMakeCache.txt"
  if [ ! -f "${cache}" ]; then
    echo "Missing CMake cache: ${cache}" >&2
    exit 1
  fi

  build_type="$(
    sed -n 's/^CMAKE_BUILD_TYPE:[^=]*=//p' "${cache}" |
      tail -n 1
  )"
  if [ -z "${build_type}" ]; then
    echo "Could not read CMAKE_BUILD_TYPE from ${cache}" >&2
    exit 1
  fi
  if [ "${build_type}" != "${expected_build_type}" ]; then
    echo "Expected ${expected_build_type} CMake build in ${build_dir}, found ${build_type}." >&2
    exit 1
  fi

  echo "cmake_build_type_ok=${build_dir}"
  echo "cmake_build_type=${build_type}"
done
